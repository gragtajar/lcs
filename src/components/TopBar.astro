---
import Icon from './Icon.astro';
import ThemeToggle from '../islands/ThemeToggle.tsx';
import SearchOverlay from '../islands/SearchOverlay.tsx';
import { t } from '../lib/i18n';
---

<header class="topbar" data-pagefind-ignore>
  <div class="topbar-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">civic</span>
      <span class="brand-name">{t('siteName')}</span>
    </a>

    {
      /* The accessible name is the visible label, so voice-control users can say
        what they see (WCAG 2.5.3); on phones the label is hidden and this is
        the button's only name. */
    }
    <button
      class="search-trigger"
      type="button"
      data-search-trigger
      aria-label={t('topbar.searchPlaceholder')}
    >
      <Icon name="search" />
      <span class="search-trigger-label">{t('topbar.searchPlaceholder')}</span>
      <kbd class="search-trigger-kbd">/</kbd>
    </button>

    <div class="topbar-actions">
      <ThemeToggle
        client:idle
        labels={{ toDark: t('topbar.switchToDark'), toLight: t('topbar.switchToLight') }}
      />
    </div>
  </div>
</header>

{
  /* Outside the header on purpose: the header's backdrop-filter makes it the
     containing block for position: fixed descendants, which shrank the
     overlay's full-screen backdrop to the 60px bar. Clicks outside the panel
     then landed on the page instead of closing the search. */
}
<SearchOverlay
  client:idle
  strings={{
    open: t('topbar.openSearch'),
    close: t('topbar.closeSearch'),
    title: t('search.title'),
    placeholder: t('search.placeholder'),
    prompt: t('search.prompt'),
    noResults: t('search.noResults'),
    comingSoonChip: t('search.comingSoonChip'),
    seeAllOne: t('search.seeAll_one'),
    seeAllOther: t('search.seeAll_other'),
    searching: t('search.searching'),
    resultsOne: t('search.results_one'),
    resultsOther: t('search.results_other'),
  }}
/>

<script>
  // Wire the (server-rendered) search trigger button to the (client-side) overlay.
  document.querySelectorAll('[data-search-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('lcs:open-search'));
    });
  });
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    -webkit-backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .topbar-inner {
    max-width: var(--width-content);
    margin-inline: auto;
    height: var(--topbar-h);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-4);
  }
  @media (min-width: 768px) {
    .topbar-inner {
      padding-inline: var(--space-6);
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
  }
  .brand:hover {
    color: var(--color-text);
    text-decoration: none;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.7rem;
    font-weight: var(--weight-heading);
    letter-spacing: 0;
  }
  .brand-name {
    font-size: 0.95rem;
  }
  /* Reads as a field (what it opens), not a pill. */
  .search-trigger {
    flex: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
    border-radius: var(--radius-md);
    padding: 0.4rem 0.8rem;
    font-size: var(--text-sm);
    border: 1px solid transparent;
    max-width: 420px;
    margin-inline: auto;
  }
  .search-trigger:hover {
    border-color: var(--color-border);
  }
  .search-trigger-label {
    flex: 1;
    text-align: left;
  }
  .search-trigger-kbd {
    color: var(--color-text-muted);
  }
  @media (max-width: 640px) {
    .search-trigger {
      flex: 0 0 auto;
      padding: 0.45rem;
      max-width: none;
    }
    .search-trigger-label,
    .search-trigger-kbd {
      display: none;
    }
  }
  .topbar-actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  :global(.theme-toggle) {
    width: var(--toggle-size);
    height: var(--toggle-size);
    display: inline-grid;
    place-items: center;
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
  }
  :global(.theme-toggle:hover) {
    color: var(--color-text);
    background: var(--color-surface-alt);
  }

  /* The toggle's tooltip: the same inverted chip as the share buttons', below
     the button and aligned to its right edge (the toggle sits at the page's
     right edge). The 6px gap is padding on the tooltip itself, so the pointer
     can cross onto it without it vanishing; Escape hides it (ThemeToggle.tsx). */
  :global(.theme-toggle-wrap) {
    --toggle-size: 38px;
    position: relative;
    display: inline-flex;
  }
  :global(.theme-tip) {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: var(--z-tooltip);
    padding-top: 6px;
    opacity: 0;
    transform: translateY(-2px);
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  /* The tooltip is wider than the button and runs out to its left, so a
     diagonal move toward it crosses the empty corner beside the button. This
     invisible strip covers that corner: the width of the bar's gap, so it never
     lies over the button or the search field next to it. */
  :global(.theme-tip::before) {
    content: '';
    position: absolute;
    right: var(--toggle-size);
    bottom: 100%;
    width: var(--space-3);
    height: 16px;
  }
  :global(.theme-tip-text) {
    display: block;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: var(--elevation-2);
  }
  @media (hover: hover) {
    :global(.theme-toggle-wrap:hover .theme-tip) {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      /* A short wait, so sweeping the pointer across the bar does not flash it. */
      transition-delay: 150ms;
    }
  }
  :global(.theme-toggle-wrap:has(:focus-visible) .theme-tip) {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  :global(.theme-toggle-wrap[data-tip-dismissed] .theme-tip) {
    opacity: 0;
    pointer-events: none;
  }

  /* Search overlay (rendered by the island, styled here so SSR + hydration share it). */
  :global(.search-overlay) {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
  }
  :global(.search-backdrop) {
    /* Rendered as a button for keyboard accessibility; styled to look like a backdrop. */
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 45%);
    border: 0;
    padding: 0;
    cursor: default;
  }
  :global(.search-panel) {
    position: relative;
    margin: 6vh auto 0;
    max-width: 640px;
    background: var(--color-surface);
    color: var(--color-text);
    border-radius: var(--radius-lg);
    box-shadow: var(--elevation-3);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  @media (max-width: 640px) {
    :global(.search-panel) {
      margin: 0;
      border-radius: 0;
      height: 100vh;
      max-width: none;
    }
  }
  :global(.search-input-row) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  /* The loading state: the magnifier turns into a spinner while a search is
     slow (SearchOverlay.tsx / SearchPage.tsx), in the same spot, so the eye
     that is on the query sees it. Without motion it stays a still ring. */
  :global(.search-loading) {
    color: var(--color-primary);
    animation: lcs-spin 0.8s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.search-loading) {
      animation: none;
    }
  }
  :global(.search-input) {
    flex: 1;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--text-base);
    outline: none;
  }
  :global(.search-close) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
  }
  :global(.search-results) {
    max-height: 60vh;
    overflow-y: auto;
    padding: var(--space-2) 0;
    /* Rows the arrow keys scroll into view keep this much room at the edge. */
    scroll-padding-block: var(--space-2);
  }
  @media (max-width: 640px) {
    :global(.search-results) {
      max-height: calc(100vh - 70px);
    }
  }
  :global(.search-result) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    color: var(--color-text);
    border-radius: 0;
  }
  :global(.search-result:hover),
  :global(.search-result.active) {
    background: var(--color-surface-alt);
    text-decoration: none;
  }
  :global(.search-result-title-row) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  :global(.search-result-title) {
    font-weight: var(--weight-ui);
  }
  :global(.search-result.soon .search-result-title) {
    color: var(--color-text-secondary);
  }
  :global(.search-result-chip) {
    font-size: var(--text-xs);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 1px 7px;
    border-radius: var(--radius-full);
    font-weight: var(--weight-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  :global(.search-result-breadcrumb) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
  /* The /search/ page renders the same row with the match marked in the palette
     (never the browser's yellow) and the format word in the lesson's cluster ink. */
  :global(.search-result-excerpt) {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: var(--measure);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Text colour, not the excerpt's secondary: on the dark selection tint the
     secondary ink is 4.2:1; the full ink is 7.4:1 (12.6:1 in light). */
  :global(.search-result mark) {
    background: var(--color-selection);
    color: var(--color-text);
    border-radius: 2px;
  }
  :global(.search-result-format) {
    color: var(--cluster-ink, var(--color-primary));
    font-weight: var(--weight-ui);
  }
  /* The overlay's handoff to the shareable results page. */
  :global(.search-see-all) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }
  :global(.search-see-all .icon) {
    width: 18px;
    height: 18px;
  }
  :global(.search-empty) {
    color: var(--color-text-muted);
    padding: var(--space-5) var(--space-4);
    text-align: center;
  }
</style>
