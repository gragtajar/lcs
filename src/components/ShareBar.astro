---
// ShareBar (brief §9). Web Share API when available, with per-platform fallback
// links that work without JS. Two variants:
//   compact — a small "Share" button (top of article); reveals the fallback row
//             when the Web Share API is absent.
//   full    — all platform buttons visible (bottom of article).
// The per-platform <a> links are real intents (no JS needed). The native-share +
// copy buttons are progressively enhanced by the deferred module script below.
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import { buildShareLinks } from '../lib/share';

interface Props {
  /** Canonical absolute URL. */
  url: string;
  title: string;
  description?: string;
  articleId: string;
  variant?: 'compact' | 'full';
}

const { url, title, description, articleId, variant = 'compact' } = Astro.props;
const links = buildShareLinks({ url, title });

const platforms = [
  {
    platform: 'whatsapp',
    href: links.whatsapp,
    icon: 'whatsapp',
    labelKey: 'share.onWhatsapp',
    newTab: true,
  },
  {
    platform: 'twitter',
    href: links.twitter,
    icon: 'twitter',
    labelKey: 'share.onTwitter',
    newTab: true,
  },
  {
    platform: 'linkedin',
    href: links.linkedin,
    icon: 'linkedin',
    labelKey: 'share.onLinkedin',
    newTab: true,
  },
  {
    platform: 'telegram',
    href: links.telegram,
    icon: 'telegram',
    labelKey: 'share.onTelegram',
    newTab: true,
  },
  { platform: 'email', href: links.email, icon: 'mail', labelKey: 'share.viaEmail', newTab: false },
] as const;
---

<div
  class:list={['sharebar', `sharebar-${variant}`]}
  data-sharebar
  data-url={url}
  data-title={title}
  data-desc={description ?? title}
  data-article-id={articleId}
>
  {
    variant === 'compact' ? (
      <>
        <button
          class="sb-trigger"
          type="button"
          data-share-native
          aria-expanded="false"
          aria-label={t('share.shareThis')}
        >
          <Icon name="share" />
          <span>{t('share.share')}</span>
        </button>
        <div class="sb-fallback" data-share-fallback hidden>
          {platforms.map((p) => (
            <a
              class="sb-icon"
              href={p.href}
              data-platform={p.platform}
              data-tooltip={t(p.labelKey)}
              aria-label={t(p.labelKey)}
              {...(p.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Icon name={p.icon} />
            </a>
          ))}
          <button
            class="sb-icon"
            type="button"
            data-share-copy
            data-tooltip={t('share.copyLink')}
            data-copy-label={t('share.copyLink')}
            data-copied-label={t('share.copied')}
            data-failed-label={t('share.copyFailed')}
            aria-label={t('share.copyLink')}
          >
            <Icon name="link" />
          </button>
        </div>
      </>
    ) : (
      <>
        <span class="sb-label">{t('share.shareThisLesson')}</span>
        <div class="sb-row">
          <button
            class="sb-icon sb-native-opt"
            type="button"
            data-share-native-optional
            data-tooltip={t('share.shareThis')}
            aria-label={t('share.shareThis')}
            hidden
          >
            <Icon name="share" />
          </button>
          {platforms.map((p) => (
            <a
              class="sb-icon"
              href={p.href}
              data-platform={p.platform}
              data-tooltip={t(p.labelKey)}
              aria-label={t(p.labelKey)}
              {...(p.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Icon name={p.icon} />
            </a>
          ))}
          <button
            class="sb-icon"
            type="button"
            data-share-copy
            data-tooltip={t('share.copyLink')}
            data-copy-label={t('share.copyLink')}
            data-copied-label={t('share.copied')}
            data-failed-label={t('share.copyFailed')}
            aria-label={t('share.copyLink')}
          >
            <Icon name="link" />
          </button>
        </div>
      </>
    )
  }
  {
    /* Screen-reader announcement for the copy action; the visual feedback is the
      copy button's tooltip. */
  }
  <span class="sb-sr-only" data-share-live role="status" aria-live="polite"></span>
</div>

<script>
  import { canNativeShare, invokeNativeShare, copyToClipboard } from '../lib/share';
  import { trackArticleShare } from '../lib/analytics';

  function initShareBars(): void {
    document.querySelectorAll<HTMLElement>('[data-sharebar]').forEach((bar) => {
      if (bar.dataset.shareReady) return;
      bar.dataset.shareReady = '1';

      const url = bar.dataset.url || location.href;
      const title = bar.dataset.title || document.title;
      const text = bar.dataset.desc || title;
      const articleId = bar.dataset.articleId || '';

      const live = bar.querySelector<HTMLElement>('[data-share-live]');

      // Compact trigger: native share if supported, otherwise reveal the fallback row.
      const trigger = bar.querySelector<HTMLButtonElement>('[data-share-native]');
      const fallback = bar.querySelector<HTMLElement>('[data-share-fallback]');
      trigger?.addEventListener('click', async () => {
        if (canNativeShare()) {
          const ok = await invokeNativeShare({ title, text, url });
          if (ok) trackArticleShare({ articleId, platform: 'native' });
        } else if (fallback) {
          const willOpen = fallback.hidden;
          fallback.hidden = !willOpen;
          trigger.setAttribute('aria-expanded', String(willOpen));
        }
      });

      // Full variant: reveal the optional native button only when supported.
      const nativeOpt = bar.querySelector<HTMLButtonElement>('[data-share-native-optional]');
      if (nativeOpt && canNativeShare()) {
        nativeOpt.hidden = false;
        nativeOpt.addEventListener('click', async () => {
          const ok = await invokeNativeShare({ title, text, url });
          if (ok) trackArticleShare({ articleId, platform: 'native' });
        });
      }

      // Per-platform links still navigate; we just record the click.
      bar.querySelectorAll<HTMLElement>('[data-platform]').forEach((node) => {
        node.addEventListener('click', () => {
          trackArticleShare({ articleId, platform: node.dataset.platform || 'unknown' });
        });
      });

      // Copy link: on success, flip the button's tooltip to "Link copied" and
      // force it visible for ~1.8s, then revert to "Copy link" so the next hover
      // reads "Copy link" again. The sr-only live region announces it.
      const copyBtn = bar.querySelector<HTMLButtonElement>('[data-share-copy]');
      let copyTimer: number | undefined;
      copyBtn?.addEventListener('click', async () => {
        const ok = await copyToClipboard(url);
        if (ok) trackArticleShare({ articleId, platform: 'copy_link' });
        // A blocked clipboard (insecure context, permission denied) used to fail
        // silently; now the tooltip says so, the same way it confirms success.
        const label = ok
          ? copyBtn.dataset.copiedLabel || 'Link copied'
          : copyBtn.dataset.failedLabel || "Couldn't copy the link";
        copyBtn.dataset.tooltip = label;
        copyBtn.classList.add('sb-tooltip-show');
        if (live) live.textContent = label;
        if (copyTimer) clearTimeout(copyTimer);
        copyTimer = window.setTimeout(() => {
          copyBtn.classList.remove('sb-tooltip-show');
          copyBtn.dataset.tooltip = copyBtn.dataset.copyLabel || 'Copy link';
          if (live) live.textContent = '';
        }, 1800);
      });
    });
  }

  initShareBars();
</script>

<style>
  .sharebar {
    position: relative;
  }
  .sharebar-compact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
    /* Breathing room from the hero above and the TL;DR box below. */
    margin-block: var(--space-4) var(--space-6);
  }

  .sb-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    cursor: pointer;
  }
  .sb-trigger:hover {
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    color: var(--color-primary);
  }
  .sb-trigger :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .sb-fallback {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  /* The bottom bar is an appendix, not a toolbar: a quiet inline label and
     ghost icon buttons on one line. Targets stay 44px; the visible mark is small. */
  .sharebar-full {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .sb-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .sb-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }

  .sb-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .sb-icon:hover {
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    color: var(--color-primary);
    text-decoration: none;
  }
  .sb-icon :global(.icon) {
    width: 22px;
    height: 22px;
  }
  /* Ghost variant for the bottom bar. */
  .sharebar-full .sb-icon {
    border-color: transparent;
    background: transparent;
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
  }
  .sharebar-full .sb-icon:hover,
  .sharebar-full .sb-icon:focus-visible {
    background: var(--color-surface-alt);
    border-color: transparent;
    color: var(--color-text);
  }
  .sharebar-full .sb-icon :global(.icon) {
    width: 20px;
    height: 20px;
  }

  /* Hover/focus tooltip above each icon (also force-shown for the copy "Link
     copied" state via .sb-tooltip-show). High-contrast, inverted per theme. */
  .sb-icon[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    z-index: var(--z-tooltip);
    box-shadow: var(--elevation-2);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .sb-icon[data-tooltip]:hover::after,
  .sb-icon[data-tooltip]:focus-visible::after,
  .sb-icon.sb-tooltip-show[data-tooltip]::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .sb-icon[data-tooltip]::after {
      transition: opacity var(--dur-fast) var(--ease-out);
      transform: translateX(-50%);
    }
    .sb-icon[data-tooltip]:hover::after,
    .sb-icon[data-tooltip]:focus-visible::after,
    .sb-icon.sb-tooltip-show[data-tooltip]::after {
      transform: translateX(-50%);
    }
  }

  /* Visually hidden; carries the copy announcement for screen readers. */
  .sb-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Comfortable touch targets on small screens. */
  @media (max-width: 640px) {
    .sb-icon {
      width: 48px;
      height: 48px;
    }
    .sb-trigger {
      min-height: 48px;
    }
  }
</style>
