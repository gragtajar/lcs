---
// Hero (homepage brief §1). Positive, world-applicable framing first; the disclaimer
// lives below the fold in MissionSection. Two columns on the site grid: the claim on
// the left (h1, lede, the facts line) and, on the right, what a first-time visitor
// actually needs next — a short list of lessons to start with. No search field
// here: the top bar's trigger sits 60px above and opens the overlay, and two search
// boxes on one screen promised different things. No scroll cue either: the library
// line at the foot of the list is the way down.
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import type { HeroChip } from '../lib/homepage-data';

interface Props {
  chips: HeroChip[];
  lessonCount: number;
  clusterCount: number;
}

const { chips, lessonCount, clusterCount } = Astro.props;
---

<section class="hero">
  <div class="hero-claim">
    <h1 class="hero-h1">{t('homepage.hero.h1')}</h1>
    <p class="hero-lede">{t('homepage.hero.body')}</p>
    <p class="hero-facts">{t('homepage.hero.subhead')}</p>
  </div>

  {
    chips.length > 0 && (
      <div class="hero-start">
        <h2 class="hero-start-h" id="start-h">
          {t('homepage.hero.startHere')}
        </h2>
        <ul class="start-list" aria-labelledby="start-h">
          {chips.map((chip) => (
            <li class="start-item" data-cluster={chip.category}>
              <a class="start-link" href={chip.href}>
                <span class="start-label">{chip.label}</span>
                {chip.minutes ? (
                  <span class="start-meta">{t('list.minRead', { n: chip.minutes })}</span>
                ) : null}
              </a>
            </li>
          ))}
        </ul>
        <a class="hero-all" href="#topics">
          {t('homepage.hero.allLessons', { count: lessonCount, clusterCount })}
          <Icon name="expand_more" />
        </a>
      </div>
    )
  }
</section>

<style>
  /* The page grid, not a centred column: the h1 lines up with the brand mark. */
  .hero {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 4.5rem) var(--space-4) var(--space-6);
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .hero {
      padding-inline: var(--space-6);
    }
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-8);
      align-items: start;
    }
  }

  /* The site's one true display moment: 44px on a phone, 68px on a desktop, so the
     three-word claim breaks into two balanced lines. Tracking tightens past the
     display token because letterforms this large need it; the floor is -0.04em. */
  .hero-h1 {
    font-size: clamp(2.75rem, 1.6rem + 4vw, 4.25rem);
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-4);
  }
  .hero-lede {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: var(--measure);
    margin: 0 0 var(--space-4);
  }
  /* The five claims, kept as written, at the weight of a facts line rather than
     a second headline. */
  .hero-facts {
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Start-here list: hairline rows, the whole row a link. Colour arrives only on
     hover, in the lesson's own cluster ink; five inks at rest would out-shout the h1. */
  .hero-start-h {
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    margin: 0 0 var(--space-2);
  }
  .start-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .start-item {
    border-top: 1px solid var(--color-border);
  }
  .start-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  /* A long label wraps within its box; the reading time stays on the first line,
     right-aligned, so the column of times lines up down the list. */
  .start-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) 0;
    color: var(--color-text);
  }
  .start-link:hover {
    text-decoration: none;
  }
  .start-label {
    min-width: 0;
    font-weight: var(--weight-ui);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .start-link:hover .start-label,
  .start-link:focus-visible .start-label {
    color: var(--cluster-ink, var(--color-primary));
  }
  .start-meta {
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* The library line doubles as the way to the full index further down. */
  .hero-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }
  .hero-all :global(.icon) {
    width: 18px;
    height: 18px;
  }
</style>
