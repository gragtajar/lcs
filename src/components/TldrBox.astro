---
import { t } from '../lib/i18n';
import { renderInline } from '../lib/markdown';

interface Props {
  items: string[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="tldr" aria-label={t('article.tldr')}>
      <p class="tldr-label">{t('article.tldr')}</p>
      <ul class="tldr-list">
        {items.map((item) => (
          <li set:html={renderInline(item)} />
        ))}
      </ul>
    </aside>
  )
}

<style>
  /* The summary panel takes the page's cluster colour (the article was the one
     surface that went mute), and the amber that also means "coming soon" and
     "wrong answer" is no longer spent here. Tint, not a border: the panel alone
     marks the block. */
  .tldr {
    background: color-mix(
      in srgb,
      var(--cluster-soft, var(--color-primary-soft)) 60%,
      var(--color-surface)
    );
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-6);
    border-radius: var(--radius-md);
    margin: 0 0 var(--space-7);
  }
  .tldr-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--cluster-ink, var(--color-primary));
    font-weight: var(--weight-heading);
    margin-bottom: var(--space-3);
  }
  .tldr-list {
    margin: 0;
    padding-left: var(--space-4);
    color: var(--color-text);
    list-style: none;
  }
  .tldr-list li {
    position: relative;
    margin-block: var(--space-2);
    line-height: 1.55;
  }
  /* A small square in the cluster ink instead of the browser bullet. */
  .tldr-list li::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-4));
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--cluster-ink, var(--color-primary));
  }
  @media (max-width: 640px) {
    .tldr {
      padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    }
  }
</style>
