---
import Icon from './Icon.astro';
import ArticleHero from './ArticleHero.astro';
import { t, formatDate } from '../lib/i18n';
import { hasArticleImage } from '../lib/images';
import type { LessonFormat, Lesson } from '../lib/content';

// Header renders identically for published and coming-soon articles
// (per addendum §2.2). The difference is in the metadata row:
//   - published: reading time + last_updated date
//   - coming-soon: "Coming soon" badge + outlined format chip
//
// The image placeholder is always shown; for coming-soon it's slightly
// desaturated to soften the visual.

interface Props {
  title: string;
  format: LessonFormat;
  comingSoon: boolean;
  /** When published, pass the parsed lesson to fill length_min + last_updated. */
  lesson?: Lesson | null;
}

const { title, format, comingSoon, lesson } = Astro.props;
---

<header
  class={`ah ${comingSoon ? 'ah-soon' : ''}`}
  data-article-id={!comingSoon && lesson ? lesson.id : undefined}
>
  <h1 class="ah-title">{title}</h1>
  {
    /* One quiet line: what kind of lesson, how long, how fresh. The format leads
       in the cluster's ink (it names the lesson's structure, which the TOC then
       shows); the icons and the "v1.0" stamp are gone — neither told a reader
       anything the words don't. */
  }
  <p class="ah-meta" data-pagefind-ignore>
    <span class={`ah-format ${comingSoon ? 'ah-format-soon' : ''}`}>
      {t(`article.format.${format}`)}
    </span>
    {
      comingSoon ? (
        <span class="ah-soon-badge">
          <Icon name="schedule" />
          {t('article.comingSoonBadge')}
        </span>
      ) : (
        <>
          <span class="ah-sep" aria-hidden="true">
            ·
          </span>
          <span>{t('list.minRead', { n: lesson?.length_min ?? 3 })}</span>
          {lesson?.last_updated && (
            <>
              <span class="ah-sep" aria-hidden="true">
                ·
              </span>
              <span>{t('list.lastUpdated', { date: formatDate(lesson.last_updated) })}</span>
            </>
          )}
        </>
      )
    }
    {
      /*
      Future-favorites insertion point (spec §15.4): a bookmark button slots in here.
      Reserved as a placeholder so the layout doesn't shift when login + favorites land.
    */
    }
    <span class="ah-fav-slot" data-future-favorite hidden>
      <Icon name="bookmark" label={t('article.favoritePlaceholder')} />
    </span>
  </p>
  {
    /* A hero only when there is a real one. 194 of 198 lessons have no image; the
       old 16:9 placeholder (a clock glyph and the wordmark) took 59% of a desktop
       fold and read as "coming soon". Without it the summary is above the fold. */
  }
  {
    !comingSoon && lesson && hasArticleImage(lesson.id) && (
      <ArticleHero articleId={lesson.id} alt={title} aspectRatio="16:9" />
    )
  }
</header>

<script>
  // Fire the `article-read` analytics event once the reader reaches the end of
  // a published article. A sentinel is appended to the article column and
  // observed; on first intersection we report the time spent on the page.
  // No-op when analytics is uninitialised (no key / Do-Not-Track).
  import { trackArticleRead } from '../lib/analytics';

  const header = document.querySelector<HTMLElement>('.ah[data-article-id]');
  const articleId = header?.dataset.articleId;
  const column = document.querySelector('.article');

  if (articleId && column) {
    const startedAt = performance.now();
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.height = '1px';
    column.append(sentinel);

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.disconnect();
        trackArticleRead({
          articleId,
          locale: document.documentElement.lang || 'en',
          timeOnPageMs: Math.round(performance.now() - startedAt),
        });
      }
    });
    observer.observe(sentinel);
  }
</script>

<style>
  .ah {
    padding: var(--space-4) 0 var(--space-5);
  }
  /* Fluid between ~30px on a phone and the page-h1 step on desktop. */
  .ah-title {
    font-size: clamp(1.75rem, 1.2rem + 3vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }
  .ah-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0;
  }
  .ah-sep {
    color: var(--color-border);
  }
  .ah-soon-badge :global(.icon) {
    width: 15px;
    height: 15px;
  }
  .ah-soon-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 3px 9px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  /* The format is a word in the cluster's ink, not a pill: it names the lesson's
     structure (scenario / rule / comparison), which the contents list then shows. */
  .ah-format {
    font-weight: var(--weight-ui);
    color: var(--cluster-ink, var(--color-primary));
  }
  .ah-format-soon {
    color: var(--color-text-muted);
  }
</style>
