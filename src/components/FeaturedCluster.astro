---
// FeaturedCluster (homepage brief §2) — one featured cluster: its name, description
// and colour on the left; on the right its three auto-selected lessons as a lead
// (title, excerpt, meta, picture) and two secondaries, in the hairline-row idiom the
// lesson list uses. No card around it and no cards inside it: the page is paper, and
// each lesson is a row whose title is the link, stretched over the row so the
// accessible name is the title alone.
//
// The lead always has a picture, at the size the lesson lists use (up to 240px,
// 16:9, on the right): the lesson's illustration (the rotation leads with an
// illustrated lesson when the topic has one), or else the topic's cover, printed
// in its own colours.
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import { categoryIconName } from '../lib/icons';
import { categoryUrl } from '../lib/content';
import { getArticleLeadPicture } from '../lib/images';
import type { FeaturedCluster } from '../lib/homepage-data';

interface Props {
  featured: FeaturedCluster;
}

const { featured } = Astro.props;
const { category, articles } = featured;
const [lead, ...rest] = articles;

const publishedCount = category.articles.filter((a) => a.published).length;
const headingId = `cluster-${category.id}`;
const leadPicture = lead ? getArticleLeadPicture(lead.lesson.id) : undefined;
const iconName = categoryIconName(category.icon);
---

<section class="cluster" data-cluster={category.id} aria-labelledby={headingId}>
  <div class="cluster-intro">
    <h3 class="cluster-name" id={headingId}>
      <span class="cluster-icon">
        <Icon name={iconName} />
      </span>
      <a href={categoryUrl(category.id)}>{category.title}</a>
    </h3>
    <p class="cluster-desc">{category.description}</p>
    <a class="cluster-browse" href={categoryUrl(category.id)}>
      {t('homepage.clusterCards.browseAll', { count: publishedCount })}
      <Icon name="chevron-right" />
    </a>
  </div>

  {
    lead && (
      <div class="cluster-lessons">
        <article class="lead">
          <h4 class="lead-title">
            <a href={lead.url}>{lead.lesson.title}</a>
          </h4>
          <p class="lead-excerpt">{lead.lesson.meta_description || lead.lesson.tldr[0] || ''}</p>
          <p class="row-meta">
            <span class="row-format">{t(`article.format.${lead.lesson.format}`)}</span>
            <span class="row-sep" aria-hidden="true">
              ·
            </span>
            <span>{t('list.minRead', { n: lead.lesson.length_min })}</span>
            {lead.englishOnly && (
              <span class="row-note" role="note">
                {t('homepage.clusterCards.englishOnlyBadge')}
              </span>
            )}
          </p>
          {leadPicture ? (
            <img
              class="lead-pic lead-img"
              src={leadPicture.src}
              srcset={leadPicture.srcset}
              sizes="(min-width: 1200px) 240px, (min-width: 960px) calc(22.67vw - 25px), (min-width: 560px) 240px, calc(40vw - 13px)"
              alt=""
              width="320"
              height="180"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="lead-pic lead-cover" aria-hidden="true">
              <span class="lead-cover-art">
                <Icon name={iconName} />
                <Icon name={iconName} />
              </span>
            </div>
          )}
        </article>

        {rest.length > 0 && (
          <ul class="secondaries">
            {rest.map(({ lesson, url, englishOnly }) => (
              <li>
                <article class="row">
                  <h4 class="row-title">
                    <a href={url}>{lesson.title}</a>
                  </h4>
                  <p class="row-meta">
                    <span class="row-format">{t(`article.format.${lesson.format}`)}</span>
                    <span class="row-sep" aria-hidden="true">
                      ·
                    </span>
                    <span>{t('list.minRead', { n: lesson.length_min })}</span>
                    {englishOnly && (
                      <span class="row-note" role="note">
                        {t('homepage.clusterCards.englishOnlyBadge')}
                      </span>
                    )}
                  </p>
                </article>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }
</section>

<style>
  /* A hairline-separated section on the page grid: intro left, lessons right. */
  .cluster {
    display: grid;
    gap: var(--space-5) var(--space-7);
    padding: var(--space-6) 0 var(--space-7);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 960px) {
    .cluster {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }

  .cluster-name {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xl);
    margin: 0 0 var(--space-3);
  }
  /* The icon sits on the name's first line, not centred on a three-line wrap. */
  .cluster-icon {
    display: inline-flex;
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--cluster-ink, var(--color-primary));
  }
  .cluster-icon :global(.icon) {
    width: 24px;
    height: 24px;
  }
  .cluster-name a {
    color: var(--color-text);
  }
  .cluster-name a:hover {
    color: var(--cluster-ink, var(--color-primary));
  }
  .cluster-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: var(--measure);
    margin: 0 0 var(--space-3);
  }
  .cluster-browse {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--cluster-ink, var(--color-primary));
  }
  .cluster-browse:hover {
    color: var(--cluster-ink, var(--color-primary));
  }
  .cluster-browse :global(.icon) {
    width: 18px;
    height: 18px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cluster-browse:hover :global(.icon) {
    transform: translateX(2px);
  }

  /* Lead and secondaries share one row grammar: the title is the link, stretched
     over the row; the focus ring outlines the row; hover paints the title in the
     cluster's ink. */
  .lead,
  .row {
    position: relative;
    cursor: pointer;
  }
  .lead-title a::after,
  .row-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .lead:has(:focus-visible),
  .row:has(:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }
  .lead-title a:focus-visible,
  .row-title a:focus-visible {
    outline: none;
  }
  .lead-title a,
  .row-title a {
    color: var(--color-text);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .lead:hover .lead-title a,
  .row:hover .row-title a {
    color: var(--cluster-ink, var(--color-primary));
    text-decoration: none;
  }

  /* The lead: its text on the left, its picture on the right at the lesson
     lists' size (a third of the column, up to 240px; 16:9, 135px tall, about
     the height of the text beside it): an accent beside the words, not a block
     over them. On phones the picture sits beside the title, and the excerpt
     runs the full width under both. */
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(8.5rem, 34%, 15rem);
    grid-template-rows: auto auto 1fr;
    grid-template-areas:
      'title pic'
      'excerpt pic'
      'meta pic';
    column-gap: var(--space-5);
    align-items: start;
  }
  .lead-title {
    grid-area: title;
  }
  .lead-excerpt {
    grid-area: excerpt;
  }
  .lead .row-meta {
    grid-area: meta;
  }
  .lead-pic {
    grid-area: pic;
    width: 100%;
    aspect-ratio: 16 / 9;
    /* Level with the title's capitals, not its line box. */
    margin-top: 4px;
    border-radius: var(--radius-md);
    outline: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
    outline-offset: -1px;
  }
  @media (max-width: 559px) {
    .lead {
      grid-template-columns: minmax(0, 1fr) 40%;
      grid-template-rows: auto;
      grid-template-areas:
        'title pic'
        'excerpt excerpt'
        'meta meta';
      column-gap: var(--space-4);
    }
    .lead-excerpt {
      margin-top: var(--space-3);
    }
  }
  /* A real illustration, 16:9 as authored, with a hairline so a pale drawing
     keeps its edge on the paper ground. */
  .lead-img {
    height: auto;
    object-fit: cover;
    background: var(--color-surface-alt);
  }
  /* No illustration yet: the topic's cover, printed like the illustrations are
     (risograph): its soft colour for paper, a halftone of its ink thickening
     toward one corner, and its mark printed twice, the second plate a little
     off register. Decorative; the title beside it is the link. */
  .lead-cover {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    container-type: inline-size;
    background: var(--cluster-soft, var(--color-primary-soft));
  }
  .lead-cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      var(--cluster-ink, var(--color-primary)) 0 1px,
      transparent 1.35px
    );
    background-size: 6px 6px;
    opacity: 0.32;
    mask-image: radial-gradient(140% 120% at 100% 100%, #000 10%, transparent 68%);
  }
  .lead-cover-art {
    position: relative;
    display: grid;
  }
  .lead-cover-art :global(.icon) {
    grid-area: 1 / 1;
    /* A quarter of the cover's width; the rem size is for browsers without
       container units. */
    width: 3.5rem;
    height: 3.5rem;
    width: 26cqi;
    height: 26cqi;
    stroke-width: 1.25;
  }
  /* The off-register plate moves with the cover's size: about 3px at 240px. */
  .lead-cover-art :global(.icon:first-child) {
    color: color-mix(in srgb, var(--cluster-ink, var(--color-primary)) 40%, transparent);
    translate: 1.2cqi 0.9cqi;
  }
  .lead-cover-art :global(.icon:last-child) {
    color: var(--cluster-ink, var(--color-primary));
  }
  .lead-title {
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    margin: 0;
    max-width: var(--measure);
  }
  /* Three lines hold a whole meta description (~155 characters at this
     measure); the clamp is a guard for the odd long one, not the normal case. */
  .lead-excerpt {
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    max-width: var(--measure);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 639px) {
    /* ~45 characters per line on a phone: four lines for the same whole thought. */
    .lead-excerpt {
      -webkit-line-clamp: 4;
      line-clamp: 4;
    }
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .row-format {
    font-weight: var(--weight-ui);
    color: var(--cluster-ink, var(--color-primary));
  }
  .row-sep {
    color: var(--color-border);
  }
  .row-note {
    color: var(--color-text-muted);
  }

  .secondaries {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: 0 var(--space-6);
  }
  @media (min-width: 640px) {
    .secondaries {
      grid-template-columns: 1fr 1fr;
    }
  }
  .row {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
  }
  .row-title {
    font-size: var(--text-base);
    line-height: var(--leading-tight);
    margin: 0;
  }
</style>
