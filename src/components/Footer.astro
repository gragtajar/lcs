---
import Logo from './Logo.astro';
import { t } from '../lib/i18n';
const year = new Date().getFullYear();
---

<footer class="footer" data-pagefind-ignore>
  <div class="footer-inner">
    <div class="footer-brand">
      <Logo class="footer-logo" />
      <strong>{t('siteName')}</strong>
      <span>{t('footer.tagline')}</span>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/about/">About</a>
      <a href="/feedback/">Feedback</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
    <p class="footer-copy">
      © {year}
      {t('siteName')} · {t('footer.copy')}
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    color: var(--color-text-secondary);
    padding: var(--space-6) var(--space-4);
    margin-top: var(--space-8);
  }
  /* A page that closes on a full-width sheet (the homepage's "Who this is
     for") hands straight over to the footer. The usual gap showed there as an
     empty band of page ground between two surfaces, like a leftover
     sub-footer. */
  :global(main:has(> [data-meets-footer]:last-child)) + .footer {
    margin-top: 0;
  }
  .footer-inner {
    max-width: var(--width-content);
    margin-inline: auto;
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  /* The logo beside the name and tagline, as tall as the two lines. */
  .footer-brand {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-3);
    row-gap: var(--space-1);
  }
  .footer-brand :global(.footer-logo) {
    grid-row: span 2;
    display: block;
    height: 44px;
    width: auto;
    aspect-ratio: 168 / 236;
  }
  .footer-brand strong {
    color: var(--color-text);
  }
  .footer-nav {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .footer-copy {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .footer-copy {
      grid-column: 1 / -1;
    }
  }
</style>
