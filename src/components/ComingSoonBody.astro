---
// The body of a planned lesson that has no file yet. It says so once, in the
// site's own words, then gives the reader something to read: the topic's
// published lesson nearest to this one, in the article's own ending grammar
// (one card), and the way to every lesson in the topic. No clock, no roadmap
// phase. Per ADR-006 the URL stays live; per the search work it stays out of the
// index body (`data-pagefind-ignore`).
import Icon from './Icon.astro';
import RelatedLinks from './RelatedLinks.astro';
import { t } from '../lib/i18n';
import { categoryUrl } from '../lib/content';
import type { RelatedLink } from '../lib/content';

interface Props {
  categoryId: string;
  categoryTitle: string;
  /** The topic's published lesson nearest to this one; none when it has nothing to read yet. */
  onward: RelatedLink | undefined;
}

const { categoryId, categoryTitle, onward } = Astro.props;
---

<section class="cs" data-pagefind-ignore>
  <p class="cs-status">{t('article.comingSoonHeading')}</p>

  <RelatedLinks next={onward} heading={t('article.meanwhileIn', { where: categoryTitle })} />

  {
    onward ? (
      <a class="cs-all" href={categoryUrl(categoryId)}>
        {t('article.allLessonsIn', { topic: categoryTitle })}
        <Icon name="chevron-right" />
      </a>
    ) : (
      <a class="cs-all" href="/#topics">
        {t('homepage.topics.heading')}
        <Icon name="chevron-right" />
      </a>
    )
  }
</section>

<style>
  .cs {
    margin: var(--space-4) 0 var(--space-7);
  }
  /* The status, once, as the body's first line: a hairline above it, the same
     weight as a lede, in the text colour rather than an alarm colour. */
  .cs-status {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text);
    max-width: var(--measure);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .cs-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }
  .cs-all :global(.icon) {
    width: 18px;
    height: 18px;
  }
</style>
