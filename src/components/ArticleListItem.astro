---
// One lesson in a topic's list. The row gives a picker what a picker needs —
// title, one line on what the lesson is about, what kind it is, how long — and
// nothing it doesn't: no date stamp (that belongs on the article), no image
// slot (few lessons have an image; the rest used to show an empty square). A
// real illustration, when there is one, sits at the row's right, big enough to
// read: beside the whole text on wide screens, beside the excerpt on phones.
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import { articleUrl } from '../lib/content';
import { getArticleThumb } from '../lib/images';
import type { PlannedArticle, Lesson } from '../lib/content';

interface Props {
  article: PlannedArticle;
  /** When the article is published, pass the parsed lesson for its excerpt + reading time. */
  lesson?: Lesson | null;
}

const { article, lesson } = Astro.props;
const url = articleUrl(article);
const isComingSoon = !article.published || !lesson;
const excerpt = lesson ? lesson.meta_description || lesson.tldr[0] || '' : '';
const thumb = isComingSoon ? undefined : getArticleThumb(article.id);
// A transparent 1x1 GIF holds a waiting picture's place, so its frame shows
// the plain tint until the picture loads; an <img> without a src drew the
// browser's broken-image icon there.
const WAITING = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<article class:list={['li', { 'li-soon': isComingSoon, 'has-thumb': thumb }]}>
  <h2 class="li-title">
    <a href={url}>{article.title}</a>
  </h2>
  {excerpt && <p class="li-excerpt">{excerpt}</p>}
  <p class="li-meta">
    <span class="li-format">{t(`article.format.${article.format}`)}</span>
    <span class="li-sep" aria-hidden="true">·</span>
    {
      isComingSoon ? (
        <span class="li-soon-badge">
          <Icon name="clock" />
          {t('list.comingSoonBadge')}
        </span>
      ) : (
        <span>{t('list.minRead', { n: lesson!.length_min })}</span>
      )
    }
  </p>
  {
    thumb && (
      <>
        <img
          class="li-thumb"
          src={WAITING}
          data-src={thumb.src}
          data-srcset={thumb.srcset}
          sizes="(max-width: 559px) 40vw, 240px"
          alt=""
          width="320"
          height="180"
          decoding="async"
        />
        <noscript class="li-thumb-noscript">
          <img
            class="li-thumb"
            src={thumb.src}
            alt=""
            width="320"
            height="180"
            loading="lazy"
            decoding="async"
          />
        </noscript>
      </>
    )
  }
</article>

<script>
  // A row's illustration loads as it comes within about two rows of the
  // screen, not when the page opens. A topic can list two dozen illustrated
  // lessons, and the browser's own lazy loading fetched 21 of the 24 on
  // /traffic/ at once (about 300 KB, past the 200 KB page budget) although a
  // screen shows four. Without script the <noscript> copy shows instead.
  const show = (img: HTMLImageElement) => {
    img.srcset = img.dataset.srcset ?? '';
    img.src = img.dataset.src ?? '';
    delete img.dataset.srcset;
    delete img.dataset.src;
  };
  const pending = document.querySelectorAll<HTMLImageElement>('img.li-thumb[data-srcset]');
  if ('IntersectionObserver' in window) {
    const near = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          near.unobserve(entry.target);
          show(entry.target as HTMLImageElement);
        }
      },
      { rootMargin: '400px 0px' },
    );
    for (const img of pending) near.observe(img);
  } else {
    for (const img of pending) show(img);
  }
</script>

<style>
  /* A hairline-separated row, not a bordered card. The whole row is the target:
     the title link is stretched over it (one accessible link per lesson), and
     the focus ring outlines the row. */
  .li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    column-gap: var(--space-5);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    cursor: pointer;
  }
  /* With an illustration: the text on the left, the image on the right at up to
     240px (16:9, 135px tall, about the height of the text beside it). */
  .li.has-thumb {
    grid-template-columns: minmax(0, 1fr) clamp(8.5rem, 34%, 15rem);
    grid-template-rows: auto auto 1fr;
    grid-template-areas:
      'title thumb'
      'excerpt thumb'
      'meta thumb';
  }
  .li.has-thumb .li-title {
    grid-area: title;
  }
  .li.has-thumb .li-excerpt {
    grid-area: excerpt;
  }
  .li.has-thumb .li-meta {
    grid-area: meta;
  }
  /* (Astro doesn't mark a <noscript> as scoped, hence :global.) */
  .li.has-thumb .li-thumb,
  .li.has-thumb > :global(.li-thumb-noscript) {
    grid-area: thumb;
  }
  /* Without script the illustration is the <noscript> copy; the deferred one
     would stay an empty frame. */
  @media (scripting: none) {
    .li-thumb[data-srcset] {
      display: none;
    }
  }
  /* Phones: the title takes the full width, and the image sits beside the
     excerpt, which gets a third line to match its height. */
  @media (max-width: 559px) {
    .li.has-thumb {
      grid-template-columns: minmax(0, 1fr) 40%;
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'title title'
        'excerpt thumb'
        'meta thumb';
      column-gap: var(--space-4);
    }
    .li.has-thumb .li-excerpt {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
    .li.has-thumb .li-thumb {
      margin-top: var(--space-2);
    }
  }
  /* The list's top hairline lives on the first row, which has its own inset. */
  :global(li:first-child) > .li {
    border-top: 1px solid var(--color-border);
  }
  .li:has(:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }
  .li-title a:focus-visible {
    outline: none;
  }
  .li-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .li-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-tight);
    margin: 0;
    max-width: var(--measure);
    text-wrap: pretty;
  }
  .li-title a {
    color: var(--color-text);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .li:hover .li-title a {
    color: var(--cluster-ink, var(--color-primary));
    text-decoration: none;
  }
  .li-excerpt {
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    max-width: var(--measure);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .li-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .li-format {
    font-weight: var(--weight-ui);
    color: var(--cluster-ink, var(--color-primary));
  }
  .li-sep {
    color: var(--color-border);
  }

  /* Coming soon: structurally different — no excerpt, muted title, a status chip
     (amber is the site's status colour, as on the article header). */
  .li-soon .li-title a {
    color: var(--color-text-secondary);
  }
  .li-soon .li-format {
    color: var(--color-text-muted);
  }
  .li-soon-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  .li-soon-badge :global(.icon) {
    width: 14px;
    height: 14px;
  }

  /* Real illustrations only, 16:9 as authored (no centre-crop into a square),
     with a hairline so a pale drawing keeps its edge on the paper ground. */
  .li-thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    outline: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
    outline-offset: -1px;
    margin-top: 4px;
  }
</style>
