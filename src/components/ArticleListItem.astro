---
// One lesson in a subtopic list. The row gives a picker what a picker needs —
// title, one line on what the lesson is about, what kind it is, how long — and
// nothing it doesn't: no date stamp (that belongs on the article), no image
// slot (4 of 211 lessons have an image; the other 207 used to show an empty
// square). A real thumbnail, when there is one, sits at the row's end.
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import { articleUrl } from '../lib/content';
import { getArticleImage, hasArticleImage } from '../lib/images';
import type { PlannedArticle, Lesson } from '../lib/content';

interface Props {
  article: PlannedArticle;
  /** When the article is published, pass the parsed lesson for its excerpt + reading time. */
  lesson?: Lesson | null;
}

const { article, lesson } = Astro.props;
const url = articleUrl(article);
const isComingSoon = !article.published || !lesson;
const excerpt = lesson ? lesson.meta_description || lesson.tldr[0] || '' : '';
const hasImage = !isComingSoon && hasArticleImage(article.id);
---

<article class={`li ${isComingSoon ? 'li-soon' : ''}`}>
  <div class="li-body">
    <h2 class="li-title">
      <a href={url}>{article.title}</a>
    </h2>
    {excerpt && <p class="li-excerpt">{excerpt}</p>}
    <p class="li-meta">
      <span class="li-format">{t(`article.format.${article.format}`)}</span>
      <span class="li-sep" aria-hidden="true">·</span>
      {
        isComingSoon ? (
          <span class="li-soon-badge">
            <Icon name="schedule" />
            {t('list.comingSoonBadge')}
          </span>
        ) : (
          <span>{t('list.minRead', { n: lesson!.length_min })}</span>
        )
      }
    </p>
  </div>
  {
    hasImage && (
      <img
        class="li-thumb"
        src={getArticleImage(article.id, 'thumbnail')}
        alt=""
        width="200"
        height="113"
        loading="lazy"
        decoding="async"
      />
    )
  }
</article>

<style>
  /* A hairline-separated row, not a bordered card. The whole row is the target:
     the title link is stretched over it (one accessible link per lesson), and
     the focus ring outlines the row. */
  .li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    cursor: pointer;
  }
  /* The list's top hairline lives on the first row, which has its own inset. */
  :global(li:first-child) > .li {
    border-top: 1px solid var(--color-border);
  }
  .li:has(:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }
  .li-title a:focus-visible {
    outline: none;
  }
  .li-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .li-body {
    min-width: 0;
  }
  .li-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-tight);
    margin: 0;
    max-width: var(--measure);
    text-wrap: pretty;
  }
  .li-title a {
    color: var(--color-text);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .li:hover .li-title a {
    color: var(--cluster-ink, var(--color-primary));
    text-decoration: none;
  }
  .li-excerpt {
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    max-width: var(--measure);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .li-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .li-format {
    font-weight: var(--weight-ui);
    color: var(--cluster-ink, var(--color-primary));
  }
  .li-sep {
    color: var(--color-border);
  }

  /* Coming soon: structurally different — no excerpt, muted title, a status chip
     (amber is the site's status colour, as on the article header). */
  .li-soon .li-title a {
    color: var(--color-text-secondary);
  }
  .li-soon .li-format {
    color: var(--color-text-muted);
  }
  .li-soon-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  .li-soon-badge :global(.icon) {
    width: 14px;
    height: 14px;
  }

  /* Real thumbnail only. 16:9 as authored (no centre-crop into a square). */
  .li-thumb {
    width: 96px;
    height: 54px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--color-surface-alt);
    margin-top: 2px;
  }
  @media (max-width: 520px) {
    .li-thumb {
      width: 80px;
      height: 45px;
    }
  }
</style>
