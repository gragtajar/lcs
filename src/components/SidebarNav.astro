---
import { categoryUrl } from '../lib/content';
import { categoryIconName } from '../lib/icons';
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import type { NavCategory } from '../lib/content';

interface Props {
  /** All 14 navigable categories (11 India + 3 abroad). Visitors is excluded. */
  categories: NavCategory[];
  /** The topic whose page this is. */
  activeCategory: string;
}
const { categories, activeCategory } = Astro.props;

// Two visual groups inside the sidebar, mirroring the homepage.
const groups: Array<{ key: string; label: string; items: NavCategory[] }> = [
  {
    key: 'india',
    label: t('home.sectionIndia'),
    items: categories.filter((c) => c.group === 'india'),
  },
  {
    key: 'abroad',
    label: t('home.sectionAbroad'),
    items: categories.filter((c) => c.group === 'abroad'),
  },
];

// Counts are of lessons a reader can open today, not of lessons planned: a
// "6" beside a topic with two readable lessons trains readers to distrust the
// numbers.
const readable = (c: NavCategory) => c.articles.filter((a) => a.published).length;
---

<aside class="sidebar" aria-label={t('list.browseCategories')}>
  <label class="sidebar-search">
    <Icon name="search" />
    <input
      type="search"
      data-sidebar-filter
      placeholder={t('list.filterCategoriesPlaceholder')}
      autocomplete="off"
      spellcheck="false"
      aria-label={t('list.filterCategoriesPlaceholder')}
    />
  </label>

  <nav class="sidebar-nav">
    {
      groups.map((g) => (
        <div class="sb-group" data-group={g.key}>
          <p class="sb-group-label">{g.label}</p>
          <ul>
            {g.items.map((c) => {
              const isActive = c.id === activeCategory;
              const n = readable(c);
              return (
                <li data-cluster={c.id} data-search-haystack={c.title.toLowerCase()}>
                  <a
                    class:list={['sb-topic', { active: isActive }]}
                    href={categoryUrl(c.id)}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    <span class="sb-topic-icon">
                      <Icon name={categoryIconName(c.icon)} />
                    </span>
                    <span class="sb-topic-title">{c.title}</span>
                    <span class="sb-topic-count">{n > 0 ? n : t('list.soonShort')}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
    <p class="sidebar-empty" data-sidebar-empty hidden>{t('list.noCategoriesMatch')}</p>
  </nav>
</aside>

<script>
  /* Bring the current topic into view inside the sidebar's own scroll box. For
     topics late in the list it otherwise sits below the fold of the sidebar,
     exactly where "you are here" matters most. */
  document.querySelectorAll<HTMLElement>('.sidebar').forEach((box) => {
    const active = box.querySelector<HTMLElement>('.sb-topic.active');
    if (!active) return;
    const top = active.offsetTop;
    const bottom = top + active.offsetHeight;
    if (top < box.scrollTop || bottom > box.scrollTop + box.clientHeight) {
      box.scrollTop = Math.max(0, top - box.clientHeight / 2);
    }
  });

  /* Sidebar name-only filter (spec §11.2): topics by their titles. Pure
     client-side, no Pagefind required. Hides whole groups with no match. */
  document.querySelectorAll<HTMLInputElement>('[data-sidebar-filter]').forEach((input) => {
    const root = input.closest('.sidebar') as HTMLElement | null;
    if (!root) return;
    const emptyMsg = root.querySelector<HTMLElement>('[data-sidebar-empty]');
    const groups = root.querySelectorAll<HTMLElement>('.sb-group');

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      groups.forEach((groupEl) => {
        let inGroup = 0;
        groupEl.querySelectorAll<HTMLElement>('li[data-search-haystack]').forEach((li) => {
          const match = !q || (li.dataset.searchHaystack ?? '').includes(q);
          li.hidden = !match;
          if (match) inGroup++;
        });
        groupEl.hidden = inGroup === 0;
        visible += inGroup;
      });
      if (emptyMsg) emptyMsg.hidden = visible > 0;
    });
  });
</script>

<style>
  /* A quiet navigation column: no panel behind it, no tree lines, no pills.
     Only the current topic carries its colour; the other thirteen icons stay
     in muted ink so a 14-hue column does not out-shout the page. */
  .sidebar {
    padding: var(--space-4) var(--space-3) var(--space-6);
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .sidebar-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.45rem 0.8rem;
    margin: 0 var(--space-1) var(--space-5);
    color: var(--color-text-muted);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .sidebar-search:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }
  .sidebar-search :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .sidebar-search input {
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    outline: none;
    flex: 1;
    min-width: 0;
  }
  .sidebar-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sb-group + .sb-group {
    margin-top: var(--space-6);
  }
  .sb-group-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--weight-ui);
    margin: 0 0 var(--space-2);
    padding-inline: var(--space-2);
  }
  .sb-topic {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    line-height: 1.35;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .sb-topic:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
    text-decoration: none;
  }
  .sb-topic-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-text-muted);
  }
  .sb-topic-icon :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .sb-topic-title {
    flex: 1;
    min-width: 0;
  }
  .sb-topic-count {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-body);
    color: var(--color-text-muted);
  }
  .sb-topic.active {
    background: var(--cluster-soft, var(--color-primary-soft));
    color: var(--cluster-ink, var(--color-primary));
  }
  .sb-topic.active .sb-topic-icon,
  .sb-topic.active .sb-topic-count {
    color: var(--cluster-ink, var(--color-primary));
  }
  .sidebar-empty {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    padding: var(--space-3);
    text-align: center;
  }
</style>
