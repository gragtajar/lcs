---
import { subtopicUrl } from '../lib/content';
import { categoryIconName } from '../lib/icons';
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import type { NavCategory } from '../lib/content';

interface Props {
  /** All 14 navigable categories (11 India + 3 abroad). Visitors is excluded. */
  categories: NavCategory[];
  activeCategory: string;
  activeSubtopic: string;
}
const { categories, activeCategory, activeSubtopic } = Astro.props;

// Two visual groups inside the sidebar, mirroring the homepage.
const indiaCats = categories.filter((c) => c.group === 'india');
const abroadCats = categories.filter((c) => c.group === 'abroad');
const groups: Array<{ key: string; label: string; items: NavCategory[] }> = [
  { key: 'india', label: t('home.sectionIndia'), items: indiaCats },
  { key: 'abroad', label: t('home.sectionAbroad'), items: abroadCats },
];

// Counts are of lessons a reader can open today, not of lessons planned: a
// "6" beside a subtopic with two readable lessons trains readers to distrust
// the numbers.
const readable = (s: NavCategory['subtopics'][number]) =>
  s.articles.filter((a) => a.published).length;
---

<aside class="sidebar" aria-label={t('list.browseCategories')}>
  <label class="sidebar-search">
    <Icon name="search" />
    <input
      type="search"
      data-sidebar-filter
      placeholder={t('list.filterCategoriesPlaceholder')}
      autocomplete="off"
      spellcheck="false"
      aria-label={t('list.filterCategoriesPlaceholder')}
    />
  </label>

  <nav class="sidebar-nav">
    {
      groups.map((g) => (
        <div class="sb-group" data-group={g.key}>
          <p class="sb-group-label">{g.label}</p>
          <ul>
            {g.items.map((c) => {
              const isActiveCategory = c.id === activeCategory;
              return (
                <li
                  class={`sb-cluster ${isActiveCategory ? 'is-active' : ''}`}
                  data-cluster={c.id}
                  data-search-haystack={c.title.toLowerCase()}
                >
                  <details open={isActiveCategory}>
                    <summary class="sb-cluster-header">
                      <span class="sb-cluster-icon">
                        <Icon name={categoryIconName(c.icon)} />
                      </span>
                      <span class="sb-cluster-title">{c.title}</span>
                      <Icon name="expand_more" class="sb-chevron" />
                    </summary>
                    <ul class="sb-sub-list">
                      {c.subtopics.map((s) => {
                        const isActive = isActiveCategory && s.id === activeSubtopic;
                        const haystack = `${c.title} ${s.title}`.toLowerCase();
                        const n = readable(s);
                        return (
                          <li data-search-haystack={haystack}>
                            <a
                              class={`sb-sub ${isActive ? 'active' : ''}`}
                              href={subtopicUrl(c.id, s.id)}
                              aria-current={isActive ? 'page' : undefined}
                            >
                              <span>{s.title}</span>
                              <span class="sb-sub-count">{n > 0 ? n : t('list.soonShort')}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
    <p class="sidebar-empty" data-sidebar-empty hidden>{t('list.noCategoriesMatch')}</p>
  </nav>
</aside>

<script>
  /* Bring the current subtopic into view inside the sidebar's own scroll box.
     For categories late in the list the active entry otherwise sits below the
     fold of the sidebar, exactly where "you are here" matters most. */
  document.querySelectorAll<HTMLElement>('.sidebar').forEach((box) => {
    const active = box.querySelector<HTMLElement>('.sb-sub.active');
    if (!active) return;
    const top = active.offsetTop;
    const bottom = top + active.offsetHeight;
    if (top < box.scrollTop || bottom > box.scrollTop + box.clientHeight) {
      box.scrollTop = Math.max(0, top - box.clientHeight / 2);
    }
  });

  /* Sidebar name-only filter (spec §11.2). Filters categories AND their subtopics
     by string match on their titles. Pure client-side, no Pagefind required.
     Also hides whole groups whose categories all filter out. */
  document.querySelectorAll<HTMLInputElement>('[data-sidebar-filter]').forEach((input) => {
    const root = input.closest('.sidebar') as HTMLElement | null;
    if (!root) return;
    const emptyMsg = root.querySelector<HTMLElement>('[data-sidebar-empty]');
    const groups = root.querySelectorAll<HTMLElement>('.sb-group');

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let totalVisibleClusters = 0;

      groups.forEach((groupEl) => {
        let groupVisibleClusters = 0;
        const clusters = groupEl.querySelectorAll<HTMLDetailsElement>('details');

        clusters.forEach((cluster) => {
          const clusterLi = cluster.parentElement as HTMLElement;
          const clusterTitle = clusterLi.dataset.searchHaystack ?? '';
          const subs = cluster.querySelectorAll<HTMLElement>('.sb-sub-list > li');

          let anySubVisible = false;
          subs.forEach((li) => {
            const hay = li.dataset.searchHaystack ?? '';
            const match = !q || hay.includes(q);
            li.hidden = !match;
            if (match) anySubVisible = true;
          });

          const clusterMatches = !q || clusterTitle.includes(q) || anySubVisible;
          clusterLi.hidden = !clusterMatches;
          if (clusterMatches) {
            groupVisibleClusters++;
            if (q) cluster.open = true;
          }
        });

        groupEl.hidden = groupVisibleClusters === 0;
        totalVisibleClusters += groupVisibleClusters;
      });

      if (emptyMsg) emptyMsg.hidden = totalVisibleClusters > 0;
    });
  });
</script>

<style>
  /* A quiet navigation column: no panel behind it, no tree lines, no pills.
     Only the current category carries its colour; the other thirteen icons
     stay in muted ink so a 14-hue column does not out-shout the page. */
  .sidebar {
    padding: var(--space-4) var(--space-3) var(--space-6);
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .sidebar-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.45rem 0.8rem;
    margin: 0 var(--space-1) var(--space-5);
    color: var(--color-text-muted);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .sidebar-search:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }
  .sidebar-search :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .sidebar-search input {
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    outline: none;
    flex: 1;
    min-width: 0;
  }
  .sidebar-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sb-group + .sb-group {
    margin-top: var(--space-6);
  }
  .sb-group-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--weight-ui);
    margin: 0 0 var(--space-2);
    padding-inline: var(--space-2);
  }
  .sb-cluster + .sb-cluster {
    margin-top: 2px;
  }
  .sb-cluster-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    cursor: pointer;
    list-style: none;
    font-weight: var(--weight-ui);
    color: var(--color-text-secondary);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .sb-cluster-header::-webkit-details-marker {
    display: none;
  }
  .sb-cluster-header:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }
  .sb-cluster-icon {
    color: var(--color-text-muted);
    display: inline-flex;
  }
  .sb-cluster-icon :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .is-active .sb-cluster-header {
    color: var(--color-text);
  }
  .is-active .sb-cluster-icon {
    color: var(--cluster-ink, var(--color-primary));
  }
  .sb-cluster-title {
    flex: 1;
    font-size: var(--text-sm);
  }
  .sb-chevron {
    color: var(--color-text-muted);
    transition: transform var(--dur-base) var(--ease-out);
    width: 18px;
    height: 18px;
  }
  details[open] .sb-chevron {
    transform: rotate(180deg);
  }
  /* Sub-lists indent to the title's left edge (icon + gap); no tree line. */
  .sb-sub-list {
    padding-left: calc(18px + var(--space-2));
    margin: var(--space-1) 0 var(--space-2);
  }
  .sb-sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 40px;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.4;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .sb-sub:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
    text-decoration: none;
  }
  .sb-sub.active {
    background: var(--cluster-soft, var(--color-primary-soft));
    color: var(--cluster-ink, var(--color-primary));
    font-weight: var(--weight-ui);
  }
  .sb-sub-count {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .sb-sub.active .sb-sub-count {
    color: var(--cluster-ink, var(--color-primary));
  }
  .sidebar-empty {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    padding: var(--space-3);
    text-align: center;
  }
</style>
