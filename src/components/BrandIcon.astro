---
/**
 * A share platform's own mark. Lucide removed all brand icons in version 1 and
 * points to Simple Icons for them, so these are drawn as solid glyphs in the
 * current text colour:
 * - WhatsApp, X and Telegram: Simple Icons (CC0-1.0), the brands' official marks.
 * - LinkedIn: Simple Icons (v16) no longer includes it, so its mark is
 *   Bootstrap Icons' `linkedin` (v1.13.1, MIT, (c) 2019-2024 The Bootstrap
 *   Authors, https://github.com/twbs/icons/blob/main/LICENSE).
 * Decorative: the link or button around it carries the accessible name.
 */
import { siTelegram, siWhatsapp, siX } from 'simple-icons';

type Brand = 'whatsapp' | 'x' | 'telegram' | 'linkedin';

const MARKS: Record<Brand, { viewBox: string; path: string }> = {
  whatsapp: { viewBox: '0 0 24 24', path: siWhatsapp.path },
  x: { viewBox: '0 0 24 24', path: siX.path },
  telegram: { viewBox: '0 0 24 24', path: siTelegram.path },
  linkedin: {
    viewBox: '0 0 16 16',
    path: 'M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z',
  },
};

interface Props {
  brand: Brand;
}

const { viewBox, path } = MARKS[Astro.props.brand];
---

<svg class="icon icon-brand" viewBox={viewBox} aria-hidden="true" focusable="false">
  <path d={path}></path>
</svg>
