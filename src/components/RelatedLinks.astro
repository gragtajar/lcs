---
// The lesson's ending: one "Up next" card, so the page closes on the next
// lesson rather than on a share toolbar. It says where it leads and how long it
// takes. Only the one: a list of further lessons under it pulled the eye away
// from the step that matters (removed 2026-09-27).
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import type { RelatedLink } from '../lib/content';

interface Props {
  /** The lesson to read next; nothing renders without one. */
  next: RelatedLink | undefined;
  /** The section's heading; "Up next" unless the caller has a better word. */
  heading?: string;
}
const { next, heading = t('article.upNext') } = Astro.props;
---

{
  next && (
    <section class="related" aria-labelledby="related-h" data-pagefind-ignore>
      <h2 id="related-h" class="related-title">
        {heading}
      </h2>
      <a class="next" href={next.url}>
        <span class="next-where">
          {next.subtopic}
          {next.minutes && (
            <span class="next-min"> · {t('list.minRead', { n: next.minutes })}</span>
          )}
        </span>
        <span class="next-title">{next.title}</span>
        <span class="next-cta" aria-hidden="true">
          <Icon name="chevron-right" />
        </span>
      </a>
    </section>
  )
}

<style>
  .related {
    margin-top: var(--space-8);
  }
  .related-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    margin-bottom: var(--space-4);
  }

  /* One card on the page, and it earns the elevation: the primary next step. */
  .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'where cta'
      'title cta';
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    align-items: center;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--cluster-soft, var(--color-primary-soft));
    color: var(--color-text);
    box-shadow: var(--elevation-1);
    transition:
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .next:hover {
    text-decoration: none;
    box-shadow: var(--elevation-2);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .next:hover {
      transform: translateY(-1px);
    }
  }
  .next-where {
    grid-area: where;
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--cluster-ink, var(--color-primary));
  }
  .next-min {
    font-weight: var(--weight-body);
    color: var(--color-text-secondary);
  }
  .next-title {
    grid-area: title;
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }
  .next-cta {
    grid-area: cta;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--cluster-ink, var(--color-primary));
  }
  .next-cta :global(.icon) {
    width: 20px;
    height: 20px;
  }
</style>
