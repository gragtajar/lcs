---
// The lesson's ending. The first related lesson is promoted to a single "Up
// next" card so the page closes on the second lesson, not on a share toolbar;
// the rest are a plain list. Related items say where they lead and how long
// they take, so the choice is informed rather than three equal boxes.
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import type { RelatedLink } from '../lib/content';

interface Props {
  items: RelatedLink[];
}
const { items } = Astro.props;
const [next, ...rest] = items;
---

{
  next && (
    <section class="related" aria-labelledby="related-h">
      <h2 id="related-h" class="related-title">
        {t('article.upNext')}
      </h2>
      <a class="next" href={next.url}>
        <span class="next-where">
          {next.subtopic}
          {next.minutes && (
            <span class="next-min"> · {t('list.minRead', { n: next.minutes })}</span>
          )}
        </span>
        <span class="next-title">{next.title}</span>
        <span class="next-cta" aria-hidden="true">
          <Icon name="chevron_right" />
        </span>
      </a>

      {rest.length > 0 && (
        <>
          <p class="more-label">{t('article.moreLessons')}</p>
          <ul class="more-list">
            {rest.map((r) => (
              <li>
                <a class="more-link" href={r.url}>
                  <span class="more-title">{r.title}</span>
                  <span class="more-where">
                    {r.subtopic}
                    {r.minutes && ` · ${t('list.minRead', { n: r.minutes })}`}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  )
}

<style>
  .related {
    margin-top: var(--space-8);
  }
  .related-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    margin-bottom: var(--space-4);
  }

  /* One card on the page, and it earns the elevation: the primary next step. */
  .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'where cta'
      'title cta';
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    align-items: center;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--cluster-soft, var(--color-primary-soft));
    color: var(--color-text);
    box-shadow: var(--elevation-1);
    transition:
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .next:hover {
    text-decoration: none;
    box-shadow: var(--elevation-2);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .next:hover {
      transform: translateY(-1px);
    }
  }
  .next-where {
    grid-area: where;
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--cluster-ink, var(--color-primary));
  }
  .next-min {
    font-weight: var(--weight-body);
    color: var(--color-text-secondary);
  }
  .next-title {
    grid-area: title;
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }
  .next-cta {
    grid-area: cta;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--cluster-ink, var(--color-primary));
  }
  .next-cta :global(.icon) {
    width: 20px;
    height: 20px;
  }

  .more-label {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    font-weight: var(--weight-ui);
  }
  .more-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .more-list li + li {
    border-top: 1px solid var(--color-border);
  }
  .more-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) 0;
    color: var(--color-text);
  }
  .more-link:hover {
    text-decoration: none;
  }
  .more-link:hover .more-title {
    color: var(--cluster-ink, var(--color-primary));
  }
  .more-title {
    font-weight: var(--weight-ui);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .more-where {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
