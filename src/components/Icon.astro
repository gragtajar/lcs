---
/**
 * One Lucide icon (https://lucide.dev/icons/), rendered to inline SVG at build
 * time by @lucide/astro: pages ship no icon JavaScript. `name` is the icon's
 * Lucide name from the catalogue in src/lib/icons.ts. Decorative by default
 * (aria-hidden); pass `label` only when the icon is the sole content that
 * carries meaning.
 *
 * The SVG carries the global `.icon` class (size, stroke), which a parent's
 * scoped styles reach with `:global(.icon)` on a wrapper.
 */
import type { AstroComponent } from '@lucide/astro';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import BookOpen from '@lucide/astro/icons/book-open';
import Bookmark from '@lucide/astro/icons/bookmark';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Clock from '@lucide/astro/icons/clock';
import Compass from '@lucide/astro/icons/compass';
import Droplet from '@lucide/astro/icons/droplet';
import Earth from '@lucide/astro/icons/earth';
import Flag from '@lucide/astro/icons/flag';
import Globe from '@lucide/astro/icons/globe';
import Landmark from '@lucide/astro/icons/landmark';
import Link from '@lucide/astro/icons/link';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Menu from '@lucide/astro/icons/menu';
import Plane from '@lucide/astro/icons/plane';
import Search from '@lucide/astro/icons/search';
import Share2 from '@lucide/astro/icons/share-2';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Smartphone from '@lucide/astro/icons/smartphone';
import TrafficCone from '@lucide/astro/icons/traffic-cone';
import TrainFront from '@lucide/astro/icons/train-front';
import Users from '@lucide/astro/icons/users';
import Utensils from '@lucide/astro/icons/utensils';
import Volume2 from '@lucide/astro/icons/volume-2';
import X from '@lucide/astro/icons/x';
import type { IconName } from '../lib/icons';

const ICONS: Record<IconName, AstroComponent> = {
  'arrow-left': ArrowLeft,
  'book-open': BookOpen,
  bookmark: Bookmark,
  'chevron-down': ChevronDown,
  'chevron-right': ChevronRight,
  clock: Clock,
  compass: Compass,
  droplet: Droplet,
  earth: Earth,
  flag: Flag,
  globe: Globe,
  landmark: Landmark,
  link: Link,
  mail: Mail,
  'map-pin': MapPin,
  menu: Menu,
  plane: Plane,
  search: Search,
  'share-2': Share2,
  'shield-check': ShieldCheck,
  smartphone: Smartphone,
  'traffic-cone': TrafficCone,
  'train-front': TrainFront,
  users: Users,
  utensils: Utensils,
  'volume-2': Volume2,
  x: X,
};

interface Props {
  name: IconName;
  label?: string;
  size?: number | string;
  class?: string;
}

const { name, label, size, class: cls } = Astro.props;
const LucideIcon = ICONS[name];
const className = ['icon', cls].filter(Boolean).join(' ');
const px = typeof size === 'number' ? `${size}px` : size;
const style = px ? `width:${px};height:${px}` : undefined;
const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };
---

<LucideIcon class={className} style={style} {...a11y} />
