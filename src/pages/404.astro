---
// The site's not-found page. Astro builds it as 404.html; on the host,
// public/404.php sends it with status 404 for every address the site has no
// page for (ADR 010), so it must work at any depth and for any URL.
//
// Set on the page grid like the homepage hero: the claim on the left (what
// happened, the address that was followed, and a search already filled in with
// that address's words), lessons to go to on the right, and every topic below.
// Without JavaScript it is still whole: the form submits to /search/, the right
// column is the homepage's curated "Start with one lesson". With it, the
// address's words are searched and the closest lessons replace that list.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TopicIndex from '../components/TopicIndex.astro';
import { resolveHeroChips, getTopicIndex } from '../lib/homepage-data';
import { DEFAULT_LOCALE } from '../config.ts';
import { t } from '../lib/i18n';

const start = resolveHeroChips(DEFAULT_LOCALE);
const topics = getTopicIndex(DEFAULT_LOCALE);
---

<BaseLayout
  title={t('errors.notFoundTitle')}
  description={t('errors.notFoundBody')}
  width="flush"
  noindex
>
  <section
    class="nf"
    data-nf
    data-matches-heading={t('errors.notFoundMatches')}
    data-min-read={t('list.minRead')}
  >
    <div class="nf-claim">
      <h1 class="nf-h1">{t('errors.notFoundTitle')}</h1>
      <p class="nf-lede">{t('errors.notFoundBody')}</p>
      <p class="nf-address" data-nf-address hidden>
        <span class="nf-address-label">{t('errors.notFoundAddress')}</span>
        <span class="nf-path" data-nf-path></span>
      </p>

      <form class="nf-search" action="/search/" method="get" role="search">
        <label class="nf-field">
          <Icon name="search" />
          <span class="sr-only">{t('errors.notFoundSearch')}</span>
          <input
            class="nf-input"
            type="search"
            name="q"
            placeholder={t('search.placeholder')}
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
            data-nf-query
          />
          <button class="nf-submit" type="submit">{t('errors.notFoundSearchButton')}</button>
        </label>
      </form>

      <a class="nf-home" href="/">{t('errors.notFoundHome')}</a>
    </div>

    {
      start.length > 0 && (
        <section class="nf-lessons" aria-labelledby="nf-lessons-h">
          <h2 class="nf-lessons-h" id="nf-lessons-h" data-nf-heading>
            {t('homepage.hero.startHere')}
          </h2>
          <ul class="nf-list" data-nf-list>
            {start.map((chip) => (
              <li class="start-item" data-cluster={chip.category}>
                <a class="start-link" href={chip.href}>
                  <span class="start-label">{chip.label}</span>
                  {chip.minutes ? (
                    <span class="start-meta">{t('list.minRead', { n: chip.minutes })}</span>
                  ) : null}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </section>

  <section class="nf-topics" aria-labelledby="browse-h">
    <TopicIndex groups={topics} heading={t('search.browseHeading')} id="browse" />
  </section>
</BaseLayout>

<script>
  import {
    loadPagefind,
    queryWordsFromPath,
    sharesAddressWord,
    toRow,
    type ResultRow,
  } from '../lib/search';

  const root = document.querySelector<HTMLElement>('[data-nf]');
  const path = window.location.pathname;
  // Opened as itself (/404.html, /404.php) there is no missing address to read.
  const direct = /^\/404(\.html|\.php)?\/?$/.test(path);

  if (root && !direct) {
    const address = root.querySelector<HTMLElement>('[data-nf-address]');
    const pathEl = root.querySelector<HTMLElement>('[data-nf-path]');
    const input = root.querySelector<HTMLInputElement>('[data-nf-query]');
    let shown = path;
    try {
      shown = decodeURI(path);
    } catch {
      // A malformed escape: show the address as it was sent.
    }
    if (address && pathEl) {
      pathEl.textContent = shown;
      address.hidden = false;
    }
    // The field starts from the address's last part, in its own order ("case
    // against honkng"), ready to correct; the suggestions use every part.
    const lastPart = path.split('/').filter(Boolean).pop() ?? '';
    const prefill = queryWordsFromPath(`/${lastPart}`).join(' ');
    if (input && prefill && !input.value) input.value = prefill;
    const words = queryWordsFromPath(path);
    if (words.length > 0) void suggest(root, words);
  }

  /**
   * Search the address's words, then fewer of them (the most specific first)
   * until something matches, and swap the curated list for the closest
   * published lessons. Pagefind narrows a many-word query and forgives typos,
   * so a mistyped lesson address usually finds that lesson; a result that shares
   * no word with the address is dropped, so nonsense finds nothing.
   */
  async function suggest(root: HTMLElement, words: string[]) {
    const api = await loadPagefind();
    if (!api) return;
    const tries = [words, words.slice(0, 3), words.slice(0, 1)].filter(
      (w, i, all) => all.findIndex((x) => x.join(' ') === w.join(' ')) === i,
    );
    for (const attempt of tries) {
      const found = await api.search(attempt.join(' '));
      if (found.results.length === 0) continue;
      const data = await Promise.all(found.results.slice(0, 8).map((r) => r.data()));
      const rows = data
        .map(toRow)
        .filter((r) => !r.comingSoon && sharesAddressWord(r, words))
        .slice(0, 5);
      if (rows.length === 0) continue;
      show(root, rows);
      return;
    }
  }

  function show(root: HTMLElement, rows: ResultRow[]) {
    const heading = root.querySelector<HTMLElement>('[data-nf-heading]');
    const list = root.querySelector<HTMLElement>('[data-nf-list]');
    if (!heading || !list) return;
    const minRead = root.dataset.minRead ?? '{n} min read';
    heading.textContent = root.dataset.matchesHeading ?? heading.textContent;
    list.replaceChildren(
      ...rows.map((r) => {
        const li = document.createElement('li');
        li.className = 'start-item';
        if (r.clusterId) li.dataset.cluster = r.clusterId;
        const a = document.createElement('a');
        a.className = 'start-link';
        a.href = r.url;
        const label = document.createElement('span');
        label.className = 'start-label';
        label.textContent = r.title;
        a.append(label);
        if (r.minutes) {
          const meta = document.createElement('span');
          meta.className = 'start-meta';
          meta.textContent = minRead.replace('{n}', String(r.minutes));
          a.append(meta);
        }
        li.append(a);
        return li;
      }),
    );
  }
</script>

<style>
  /* The homepage hero's grid: claim 7, lessons 5, the h1 on the brand mark's line. */
  .nf {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 4.5rem) var(--space-4) var(--space-7);
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 768px) {
    .nf {
      padding-inline: var(--space-6);
    }
  }
  @media (min-width: 960px) {
    .nf {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-8);
      align-items: start;
    }
  }

  .nf-h1 {
    font-size: clamp(2.5rem, 1.5rem + 3.2vw, 3.5rem);
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-4);
  }
  .nf-lede {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: var(--measure);
    margin: 0;
  }
  /* The address itself, so a typo or a cut-off link can be seen at a glance. */
  .nf-address {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }
  .nf-path {
    color: var(--color-text);
    font-weight: var(--weight-ui);
    overflow-wrap: anywhere;
  }

  /* The site's field idiom (as on /search/): hairline, field radius, resting
     elevation, the focus ring on the whole field. */
  .nf-search {
    margin: var(--space-6) 0 0;
    max-width: 34rem;
  }
  .nf-field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--elevation-1);
    color: var(--color-text-muted);
    cursor: text;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .nf-field:focus-within {
    border-color: var(--color-primary);
    box-shadow:
      0 0 0 3px var(--color-primary-soft),
      var(--elevation-1);
  }
  .nf-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    padding: var(--space-2) 0;
  }
  .nf-input:focus {
    outline: none;
  }
  .nf-submit {
    flex-shrink: 0;
    min-height: 40px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }
  .nf-submit:hover {
    background: var(--color-primary-hover);
  }

  .nf-home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }

  /* Lessons to go to: the hero's "Start with one lesson" rows. The rows may be
     rebuilt by the script (closest matches), hence :global. */
  .nf-lessons-h {
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    margin: 0 0 var(--space-2);
  }
  .nf-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nf-list :global(.start-item) {
    border-top: 1px solid var(--color-border);
  }
  .nf-list :global(.start-item:last-child) {
    border-bottom: 1px solid var(--color-border);
  }
  .nf-list :global(.start-link) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) 0;
    color: var(--color-text);
  }
  .nf-list :global(.start-link:hover) {
    text-decoration: none;
  }
  .nf-list :global(.start-label) {
    min-width: 0;
    font-weight: var(--weight-ui);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nf-list :global(.start-link:hover .start-label),
  .nf-list :global(.start-link:focus-visible .start-label) {
    color: var(--cluster-ink, var(--color-primary));
  }
  .nf-list :global(.start-meta) {
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .nf-topics {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: var(--space-7) var(--space-4) var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .nf-topics {
      padding-inline: var(--space-6);
    }
  }
</style>
