---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ArticleHeader from '../../../components/ArticleHeader.astro';
import TldrBox from '../../../components/TldrBox.astro';
import SourcesList from '../../../components/SourcesList.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import ComingSoonBody from '../../../components/ComingSoonBody.astro';
import ShareBar from '../../../components/ShareBar.astro';
import Icon from '../../../components/Icon.astro';
import TableOfContents from '../../../islands/TableOfContents.tsx';
import LessonQuiz, { QUIZ_SECTION_ID } from '../../../islands/LessonQuiz.tsx';
import {
  getNavCategories,
  findPlannedArticle,
  loadLessonForArticle,
  resolveRelated,
  extractRuleSections,
  categoryUrl,
  subtopicUrl,
  articleUrl,
} from '../../../lib/content';
import { renderLessonBody } from '../../../lib/markdown';
import { getArticleImage } from '../../../lib/images';
import { t } from '../../../lib/i18n';
import { articleJsonLd, howToJsonLd, breadcrumbJsonLd } from '../../../lib/seo';

// Generate ONE page per planned article — published or not.
// That's how the volumetric view gets every article a working URL
// (acceptance criterion in addendum §11).
export function getStaticPaths() {
  const out: { params: { category: string; subcategory: string; article: string } }[] = [];
  for (const c of getNavCategories()) {
    for (const s of c.subtopics) {
      for (const a of s.articles) {
        out.push({ params: { category: c.id, subcategory: s.id, article: a.slug } });
      }
    }
  }
  return out;
}

const { category, subcategory, article } = Astro.params;
const planned = findPlannedArticle(category!, subcategory!, article!);
if (!planned) return Astro.redirect('/');

const cat = planned.category;
const sub = planned.subtopic;

// Only fetch a Lesson when the article is actually live; otherwise we render
// the coming-soon variant.
const lesson = planned.published ? loadLessonForArticle(planned) : null;
const isComingSoon = !planned.published || !lesson;

// For coming-soon articles we still need the breadcrumb, title, and a "back to
// subcategory" link. No body parsing, no related, no quiz.
const rendered = isComingSoon ? null : renderLessonBody(lesson!.body);
const related = isComingSoon ? [] : resolveRelated(lesson!.related);

const canonical = articleUrl(planned);
// Absolute URL for the ShareBar (Web Share API + per-platform intents).
const shareUrl = new URL(canonical, 'https://learncivicsense.in').toString();
// <meta description>: prefer the authored meta_description, fall back to tldr[0]
// for un-backfilled articles, then category/title. `||` (not `??`) so an empty
// meta_description string falls through.
const description =
  lesson?.meta_description || lesson?.tldr?.[0] || cat.description || planned.title;

// OG/social-card overrides apply only to real articles. og:title uses the bare
// lesson title (or its og_title override); og:description prefers og_description,
// then meta_description, then the first TL;DR line.
const ogTitle = lesson ? lesson.og_title || lesson.title : undefined;
const ogDescription = lesson
  ? lesson.og_description || lesson.meta_description || lesson.tldr[0] || description
  : undefined;

// JSON-LD: real articles get a schema.org Article + BreadcrumbList.
// Coming-soon stubs only emit the breadcrumb (no Article — there's no body to describe).
const breadcrumbLd = breadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: cat.title, url: categoryUrl(cat.id) },
  { name: sub.title, url: subtopicUrl(cat.id, sub.id) },
  { name: planned.title, url: canonical },
]);
const articleLd =
  !isComingSoon && lesson
    ? articleJsonLd({
        category: cat,
        subtopic: sub,
        lesson,
        url: new URL(canonical, 'https://learncivicsense.in').toString(),
      })
    : null;

// Rule-format articles additionally emit a HowTo blob (its four sections map onto
// HowToSteps). Two ld+json blocks on one page is valid and Google handles it.
const howToLd =
  !isComingSoon && lesson && lesson.format === 'rule'
    ? howToJsonLd({ lesson, sections: extractRuleSections(lesson.body) })
    : null;

// The contents list covers the quiz too: it is a section of the lesson, and
// readers who want to jump straight to it should be able to.
const hasQuiz = !isComingSoon && !!lesson?.quiz && lesson.quiz.length > 0;
const tocItems = isComingSoon
  ? []
  : [
      ...rendered!.toc,
      ...(hasQuiz ? [{ id: QUIZ_SECTION_ID, text: t('quiz.title'), level: 2 as const }] : []),
    ];

// Pagefind only parses ONE key:value per `data-pagefind-meta` attribute, so we
// render each meta as a separate hidden span (see the article template below).
---

<BaseLayout
  title={planned.title}
  description={description}
  width="flush"
  canonical={canonical}
  type="article"
  image={isComingSoon ? undefined : getArticleImage(planned.id, 'og', true)}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    {howToLd && <script type="application/ld+json" set:html={JSON.stringify(howToLd)} />}
    {
      !isComingSoon &&
        lesson &&
        lesson.tags.map((tag) => <meta property="article:tag" content={tag} />)
    }
  </Fragment>
  <div
    class={`article-page ${isComingSoon ? 'article-page-soon' : ''}`}
    data-cluster={cat.id}
    data-pagefind-body
  >
    {
      /* Pagefind meta — one attribute per key, kept hidden from layout. The search
        surfaces read these to draw a row: where the lesson lives, its colour,
        its format, how long it takes, and whether it can be read yet. */
    }
    <span data-pagefind-meta={`cluster:${cat.title}`} hidden></span>
    <span data-pagefind-meta={`subtopic:${sub.title}`} hidden></span>
    <span data-pagefind-meta={`clusterId:${cat.id}`} hidden></span>
    <span data-pagefind-meta={`format:${t(`article.format.${planned.format}`)}`} hidden></span>
    {!isComingSoon && lesson && <span data-pagefind-meta={`minutes:${lesson.length_min}`} hidden />}
    {isComingSoon && <span data-pagefind-meta="status:coming-soon" hidden />}

    {
      /* The trail stops at the subtopic: the page's own title sits 28px below as
         the h1, and repeating it here wrapped the crumb to four lines on phones.
         The BreadcrumbList JSON-LD above still carries all four levels. */
    }
    <Breadcrumb
      items={[
        { label: t('nav.home'), href: '/' },
        { label: cat.title, href: categoryUrl(cat.id) },
        { label: sub.title, href: subtopicUrl(cat.id, sub.id) },
      ]}
    />

    <div class="article-grid">
      <article class="article">
        <ArticleHeader
          title={planned.title}
          format={planned.format}
          comingSoon={isComingSoon}
          lesson={lesson}
        />

        {
          isComingSoon ? (
            <ComingSoonBody
              phase={2}
              categoryId={cat.id}
              subtopicId={sub.id}
              subtopicTitle={sub.title}
            />
          ) : (
            <>
              <ShareBar
                variant="compact"
                url={shareUrl}
                title={lesson!.title}
                description={lesson!.meta_description || lesson!.tldr[0]}
                articleId={planned.id}
              />

              <TldrBox items={lesson!.tldr} />

              {/* Mobile-only TOC collapse, above the body. */}
              {tocItems.length > 0 && (
                <details class="toc-mobile" name="toc-mobile" data-pagefind-ignore>
                  <summary>
                    <span>{t('article.contents')}</span>
                    <Icon name="expand_more" class="toc-mobile-chevron" />
                  </summary>
                  <ol>
                    {tocItems.map((it) => (
                      <li class={`toc-${it.level}`}>
                        <a href={`#${it.id}`}>{it.text}</a>
                      </li>
                    ))}
                  </ol>
                </details>
              )}

              <div class="article-body" set:html={rendered!.html} />

              {hasQuiz && (
                <LessonQuiz
                  client:visible
                  articleId={planned.id}
                  questions={lesson!.quiz!}
                  strings={{
                    title: t('quiz.title'),
                    selectAnswer: t('quiz.selectAnswer'),
                    selectAllThatApply: t('quiz.selectAllThatApply'),
                    explanationLabel: t('quiz.explanationLabel'),
                    summary: t('quiz.summary'),
                    summaryAll: t('quiz.summaryAll'),
                  }}
                />
              )}

              {/* The ending, in this order: the next lesson (the page's last real
                   content), then the references, then a quiet share line. */}
              <RelatedLinks items={related} />
              <SourcesList sources={lesson!.sources} />

              <ShareBar
                variant="full"
                url={shareUrl}
                title={lesson!.title}
                description={lesson!.meta_description || lesson!.tldr[0]}
                articleId={planned.id}
              />
            </>
          )
        }
      </article>

      {
        tocItems.length > 0 && (
          <aside class="toc-side" data-pagefind-ignore>
            <TableOfContents client:visible items={tocItems} label={t('article.contents')} />
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .article-page {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: var(--space-5) var(--space-4) var(--space-7);
  }
  @media (min-width: 768px) {
    .article-page {
      padding-inline: var(--space-6);
    }
  }

  /* The reading column and its contents list are laid out as one centred pair,
     so the list sits beside the prose instead of across a dead strip. */
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--width-reading));
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-3);
  }
  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: minmax(0, var(--width-reading)) var(--width-toc);
      column-gap: var(--space-8);
    }
    .article-page-soon .article-grid {
      /* No TOC on coming-soon — single centred column. */
      grid-template-columns: minmax(0, var(--width-reading));
    }
  }

  .article {
    width: 100%;
    min-width: 0;
  }

  /* Floating right-rail TOC (desktop) */
  .toc-side {
    display: none;
  }
  @media (min-width: 1024px) {
    .toc-side {
      display: block;
      position: sticky;
      top: calc(var(--topbar-h) + var(--space-4));
      align-self: start;
      max-height: calc(100vh - var(--topbar-h) - var(--space-6));
      overflow-y: auto;
    }
  }

  /* Mobile TOC */
  .toc-mobile {
    display: block;
    margin-bottom: var(--space-6);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .toc-mobile {
      display: none;
    }
  }
  .toc-mobile summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) 0;
    font-weight: var(--weight-ui);
    color: var(--color-text);
  }
  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  .toc-mobile :global(.toc-mobile-chevron) {
    width: 20px;
    height: 20px;
    color: var(--color-text-muted);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .toc-mobile[open] :global(.toc-mobile-chevron) {
    transform: rotate(180deg);
  }
  .toc-mobile ol {
    margin: 0;
    padding: 0 0 var(--space-4) var(--space-5);
    list-style: decimal;
    color: var(--color-text-secondary);
  }
  .toc-mobile li {
    padding: var(--space-1) 0;
  }
  .toc-mobile li::marker {
    color: var(--color-text-muted);
  }
  .toc-mobile li.toc-3 {
    padding-left: var(--space-3);
    font-size: var(--text-sm);
  }
  .toc-mobile a {
    color: var(--color-text-secondary);
  }

  /* Desktop contents: a sentence-case label, muted items, and the current one
     in the cluster's ink with a small square marker in the gutter. */
  :global(.toc) {
    font-size: var(--text-sm);
    padding-left: var(--space-4);
  }
  :global(.toc-title) {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    font-weight: var(--weight-ui);
    margin-bottom: var(--space-3);
  }
  :global(.toc-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  :global(.toc-item a) {
    position: relative;
    color: var(--color-text-secondary);
    display: block;
    padding: var(--space-1) 0;
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease-out);
  }
  :global(.toc-item a::before) {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-4));
    top: calc(0.7em + var(--space-1) - 3px);
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--cluster-ink, var(--color-primary));
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  :global(.toc-item.toc-3 a) {
    padding-left: var(--space-3);
    font-size: var(--text-xs);
  }
  :global(.toc-item.active a) {
    color: var(--cluster-ink, var(--color-primary));
    font-weight: var(--weight-ui);
  }
  :global(.toc-item.active a::before) {
    opacity: 1;
  }
  :global(.toc-item a:hover) {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Section heads: more space above than below (craft floor), display weight
     from global.css, and the same measure as the prose so they align. */
  /* Reading size: Hind's compact letterforms read small at 17px, so the lesson
     body sits one step up. The measure token is in ch, so it scales with it
     (54ch ≈ 529px ≈ 70 characters). */
  .article-body {
    font-size: 1.125rem;
    line-height: var(--leading-body);
  }
  .article-body :global(h2) {
    font-size: var(--text-2xl);
    margin: var(--space-8) 0 var(--space-3);
    max-width: var(--measure);
    scroll-margin-top: calc(var(--topbar-h) + var(--space-4));
  }
  .article-body :global(h3) {
    font-size: var(--text-xl);
    margin: var(--space-6) 0 var(--space-2);
    max-width: var(--measure);
    scroll-margin-top: calc(var(--topbar-h) + var(--space-4));
  }
  .article-body :global(p) {
    margin: 0 0 var(--space-4);
    max-width: var(--measure);
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
    max-width: var(--measure);
  }
  .article-body :global(li) {
    margin-block: var(--space-2);
  }
  /* Pull-quote: the soft panel alone marks it; the thick coloured side-tab was
     the detector's most recognisable AI-UI tell and is gone. */
  .article-body :global(blockquote) {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    background: var(--color-primary-soft);
    color: var(--color-text);
    border-radius: var(--radius-md);
    max-width: var(--measure);
  }
  .article-body :global(blockquote p) {
    margin: 0;
  }
  .article-body :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
  }
  .article-body :global(a:hover) {
    border-bottom-color: var(--color-primary);
  }

  /* Tables read as typeset rows, not a boxed widget: hairlines between rows, a
     heavier rule under the header, and the first/last columns flush with the
     prose edge. The wrapper only exists for horizontal overflow on phones. */
  .article-body :global(.table-wrap) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: var(--space-6) 0;
  }
  .article-body :global(.table-wrap table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    min-width: 540px;
  }
  .article-body :global(.table-wrap th),
  .article-body :global(.table-wrap td) {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    line-height: 1.55;
  }
  .article-body :global(.table-wrap th:first-child),
  .article-body :global(.table-wrap td:first-child) {
    padding-left: 0;
  }
  .article-body :global(.table-wrap th:last-child),
  .article-body :global(.table-wrap td:last-child) {
    padding-right: 0;
  }
  .article-body :global(.table-wrap th) {
    font-weight: var(--weight-heading);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-text-secondary);
  }
  /* On phones the third column of a comparison was 199px off-screen behind a
     scroll nobody found. Each row becomes a stack of label/value pairs, the
     label coming from the cell's data-label (set by the markdown renderer). */
  @media (max-width: 640px) {
    .article-body :global(.table-wrap table) {
      min-width: 0;
    }
    .article-body :global(.table-wrap thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
    .article-body :global(.table-wrap tr) {
      display: block;
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--color-border);
    }
    .article-body :global(.table-wrap td) {
      display: block;
      padding: var(--space-1) 0;
      border-bottom: 0;
    }
    .article-body :global(.table-wrap td::before) {
      content: attr(data-label);
      display: block;
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-label);
      color: var(--color-text-muted);
      font-weight: var(--weight-ui);
    }
    .article-body :global(.table-wrap td:first-child) {
      font-weight: var(--weight-heading);
      color: var(--color-text);
    }
  }

  /* The quiz is the one panel in the body: a surface-alt ground with the
     appendix-step heading, so it reads as a designed component rather than a
     run of bordered rectangles. */
  :global(.quiz) {
    margin-top: var(--space-8);
    padding: var(--space-5);
    background: var(--color-surface-alt);
    border-radius: var(--radius-lg);
    scroll-margin-top: calc(var(--topbar-h) + var(--space-4));
  }
  @media (min-width: 768px) {
    :global(.quiz) {
      padding: var(--space-6);
    }
  }
  :global(.quiz-title) {
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    margin-bottom: var(--space-5);
  }
  :global(.quiz-q + .quiz-q) {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  :global(.quiz-question) {
    font-size: var(--text-base);
    font-weight: var(--weight-heading);
    margin-bottom: var(--space-1);
    line-height: 1.45;
    text-wrap: pretty;
  }
  :global(.quiz-q-num) {
    color: var(--cluster-ink, var(--color-primary));
    margin-right: var(--space-1);
  }
  :global(.quiz-hint) {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  :global(.quiz-opts) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  :global(.quiz-opt) {
    width: 100%;
    text-align: left;
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
    border: 1px solid transparent;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    color: var(--color-text);
    line-height: 1.45;
    cursor: pointer;
    box-shadow: var(--elevation-1);
  }
  :global(.quiz-opt:hover) {
    border-color: color-mix(in srgb, var(--cluster-ink, var(--color-primary)) 40%, transparent);
  }
  :global(.quiz-opt.correct) {
    border-color: var(--color-success);
    background: color-mix(in srgb, var(--color-success) 10%, var(--color-surface));
  }
  :global(.quiz-opt.wrong) {
    border-color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 8%, var(--color-surface));
  }
  /* A letter before the pick, the verdict glyph after. */
  :global(.quiz-opt-marker) {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-surface-alt);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-heading);
    line-height: 1;
  }
  :global(.quiz-opt.correct .quiz-opt-marker) {
    background: var(--color-success);
    color: #fff;
  }
  :global(.quiz-opt.wrong .quiz-opt-marker) {
    background: var(--color-warning);
    color: #fff;
  }
  :global(.quiz-opt-text) {
    padding-top: 4px;
  }
  :global(.quiz-feedback) {
    margin: var(--space-2) 0 var(--space-3) calc(28px + var(--space-3) + var(--space-3));
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
  :global(.quiz-feedback.good) {
    color: var(--color-success);
  }
  :global(.quiz-explanation) {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.55;
  }
  /* The result line appears once every question is answered. */
  :global(.quiz-summary) {
    margin: var(--space-5) 0 0;
    font-weight: var(--weight-heading);
    color: var(--cluster-ink, var(--color-primary));
    min-height: 1.5em;
  }
  :global(.quiz-summary:not(.is-done)) {
    margin: 0;
    min-height: 0;
  }
  :global(.quiz-sr) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>
