---
// /topics/ — the whole library on one page: every topic with every subtopic,
// and how many lessons each has that a reader can open today. The homepage's
// topic index links here as "Browse by subtopic"; a category page is one topic
// of this page, at length.
//
// No cards and no accordions for the content: each topic is a side-heading
// block on the page grid (the homepage's featured clusters use the same 4/8
// split), its name in its own colour on the left with what it covers and a way
// to all its lessons, its subtopics on the right as compact rows. The page's
// own index sits under the facts: rows like the homepage's topic index that
// jump to each block, folded behind one line on phones so the first screen
// still reaches the library.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import SubtopicIndex from '../components/SubtopicIndex.astro';
import {
  getNavCategories,
  loadVisitorsModule,
  categoryUrl,
  subtopicUrl,
  visitorsUrl,
  type NavCategory,
} from '../lib/content';
import { categoryIconName } from '../lib/icons';
import { t } from '../lib/i18n';

const nav = getNavCategories();
const visitors = loadVisitorsModule();

/** A topic's subtopics as rows: what can be read today, and what is coming. */
function rowsOf(c: NavCategory) {
  return c.subtopics.map((s) => {
    const readable = s.articles.filter((a) => a.published).length;
    return {
      title: s.title,
      url: subtopicUrl(c.id, s.id),
      readable,
      comingSoon: s.articles.length - readable,
    };
  });
}
function readableIn(c: NavCategory): number {
  return c.subtopics.reduce((n, s) => n + s.articles.filter((a) => a.published).length, 0);
}

const groups = [
  { key: 'india', heading: t('home.sectionIndia'), items: nav.filter((c) => c.group === 'india') },
  {
    key: 'abroad',
    heading: t('home.sectionAbroad'),
    items: nav.filter((c) => c.group === 'abroad'),
  },
];
const subtopicTotal = nav.reduce((n, c) => n + c.subtopics.length, 0);
const readableTotal = nav.reduce((n, c) => n + readableIn(c), 0);
const facts = [
  t('topics.topicCount', { count: nav.length }),
  t('category.subtopicCount', { count: subtopicTotal }),
  t('list.lessonCount', { count: readableTotal }),
];
---

<BaseLayout
  title={t('topics.title')}
  description={t('topics.lede')}
  width="wide"
  canonical="/topics/"
>
  <Breadcrumb items={[{ label: t('nav.home'), href: '/' }, { label: t('topics.title') }]} />

  <header class="tp-head">
    <h1 class="tp-title">{t('topics.title')}</h1>
    <p class="tp-lede">{t('topics.lede')}</p>
    <p class="tp-facts">
      {
        facts.map((f, i) => (
          <>
            {i > 0 && (
              <span class="tp-sep" aria-hidden="true">
                ·
              </span>
            )}
            <span>{f}</span>
          </>
        ))
      }
    </p>
  </header>

  <nav class="tp-jump-nav" aria-labelledby="tp-jump-h">
    <details class="tp-jump" data-tp-jump>
      <summary class="tp-jump-summary">
        <span id="tp-jump-h">{t('topics.jumpLabel')}</span>
        <span class="tp-jump-chevron">
          <Icon name="chevron-down" />
        </span>
      </summary>
      <div class="tp-jump-body">
        {
          groups.map((g) => (
            <div class="tp-jump-group">
              <p class="tp-jump-label">{g.heading}</p>
              <ul class="tp-jump-list">
                {g.items.map((c) => (
                  <li data-cluster={c.id}>
                    <a class="tp-jump-row" href={`#${c.id}`}>
                      <span class="tp-jump-icon">
                        <Icon name={categoryIconName(c.icon)} />
                      </span>
                      <span class="tp-jump-title">{c.title}</span>
                      <span class="tp-jump-count">
                        {t('list.lessonCount', { count: readableIn(c) })}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="tp-jump-group">
          <p class="tp-jump-label">{t('home.sectionVisitors')}</p>
          <ul class="tp-jump-list">
            <li>
              <a class="tp-jump-row" href="#visitors">
                <span class="tp-jump-icon">
                  <Icon name={categoryIconName(visitors.icon)} />
                </span>
                <span class="tp-jump-title">{visitors.title}</span>
                <span class="tp-jump-count">{t('list.comingSoonBadge')}</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </details>
  </nav>

  {
    groups.map((g) => (
      <section class="tp-group" aria-labelledby={`${g.key}-h`}>
        <h2 class="tp-group-h" id={`${g.key}-h`}>
          {g.heading}
        </h2>
        {g.items.map((c) => (
          <div class="tp-topic" data-cluster={c.id} id={c.id}>
            <div class="tp-intro">
              <h3 class="tp-name">
                <span class="tp-icon">
                  <Icon name={categoryIconName(c.icon)} />
                </span>
                <a href={categoryUrl(c.id)}>{c.title}</a>
              </h3>
              <p class="tp-desc">{c.description}</p>
              <a class="tp-browse" href={categoryUrl(c.id)}>
                {t('homepage.clusterCards.browseAll', { count: readableIn(c) })}
                <Icon name="chevron-right" />
              </a>
            </div>
            <SubtopicIndex rows={rowsOf(c)} compact />
          </div>
        ))}
      </section>
    ))
  }

  <section class="tp-group" aria-labelledby="visitors-h">
    <h2 class="tp-group-h" id="visitors-h">{t('home.sectionVisitors')}</h2>
    <div class="tp-topic tp-visitors" id="visitors">
      <p class="tp-visitors-note">
        <span class="tp-icon">
          <Icon name={categoryIconName(visitors.icon)} />
        </span>
        <span>{t('topics.visitorsNote')}</span>
      </p>
      <a class="tp-browse" href={visitorsUrl()}>
        {t('topics.visitorsLink')}
        <Icon name="chevron-right" />
      </a>
    </div>
  </section>

  {/* The way on from the end of the library: a search, as on the 404 page. */}
  <p class="tp-end">
    {t('topics.endNote')}
    <a class="tp-end-search" href="/search/">
      <Icon name="search" />
      {t('topics.endSearch')}
    </a>
  </p>
</BaseLayout>

<script>
  // The index is always open from 960px (its summary line hides there) and
  // folded behind one line on smaller screens. Without JavaScript it is simply
  // a closed disclosure with its summary showing, at every width.
  const jump = document.querySelector<HTMLDetailsElement>('[data-tp-jump]');
  const wide = window.matchMedia('(min-width: 960px)');
  const sync = () => {
    if (jump && wide.matches) jump.open = true;
  };
  sync();
  wide.addEventListener('change', sync);
  // A jump on a phone folds the index again, so Back returns to a short top.
  jump?.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('a');
    if (link && !wide.matches) jump.open = false;
  });
  // The end's search button opens the top bar's search in place (the link
  // still goes to /search/ before the overlay has loaded or without scripts).
  document.querySelector('.tp-end-search')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.dispatchEvent(new CustomEvent('lcs:open-search'));
  });
</script>

<style>
  .tp-head {
    margin: var(--space-5) 0 var(--space-6);
  }
  .tp-title,
  .tp-lede,
  .tp-facts {
    max-width: var(--width-reading);
  }
  .tp-title {
    font-size: clamp(2rem, 1.2rem + 3vw, var(--text-3xl));
    margin: 0 0 var(--space-3);
  }
  .tp-lede {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: var(--measure);
    margin: 0;
  }
  .tp-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .tp-sep {
    color: var(--color-text-muted);
  }

  /* The page's own index: the homepage topic index's rows (icon, name, count),
     each jumping to its block. */
  .tp-jump-nav {
    margin-bottom: var(--space-7);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .tp-jump-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 48px;
    list-style: none;
    cursor: pointer;
    font-weight: var(--weight-ui);
    color: var(--color-text);
  }
  .tp-jump-summary::-webkit-details-marker {
    display: none;
  }
  .tp-jump-chevron {
    display: inline-flex;
    color: var(--color-text-muted);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .tp-jump-chevron :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .tp-jump[open] .tp-jump-chevron {
    transform: rotate(180deg);
  }
  @media (min-width: 960px) {
    /* Always open here (see the script); a closed one keeps its summary. */
    .tp-jump[open] .tp-jump-summary {
      display: none;
    }
  }
  .tp-jump-body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-2) 0 var(--space-4);
  }
  .tp-jump-label {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .tp-jump-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    column-gap: var(--space-7);
  }
  @media (min-width: 768px) {
    .tp-jump-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .tp-jump-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-text);
  }
  .tp-jump-row:hover {
    text-decoration: none;
  }
  .tp-jump-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--cluster-ink, var(--color-primary));
  }
  .tp-jump-icon :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .tp-jump-title {
    flex: 1;
    min-width: 0;
    font-weight: var(--weight-ui);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .tp-jump-row:hover .tp-jump-title,
  .tp-jump-row:focus-visible .tp-jump-title {
    color: var(--cluster-ink, var(--color-primary));
  }
  .tp-jump-count {
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* A group's name, then its topics as hairline-topped blocks on the 4/8 grid. */
  .tp-group + .tp-group {
    margin-top: var(--space-8);
  }
  .tp-group-h {
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, var(--text-2xl));
    margin: 0 0 var(--space-5);
  }
  .tp-topic {
    display: grid;
    gap: var(--space-3) var(--space-7);
    padding: var(--space-5) 0 var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 960px) {
    .tp-topic {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
  }
  /* Arriving from the index: the block's rule takes its topic's colour. */
  .tp-topic:target {
    border-top: 2px solid var(--cluster-ink, var(--color-primary));
    padding-top: calc(var(--space-5) - 1px);
  }
  .tp-name {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2);
  }
  .tp-icon {
    display: inline-flex;
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--cluster-ink, var(--color-primary));
  }
  .tp-icon :global(.icon) {
    width: 24px;
    height: 24px;
  }
  .tp-name a {
    color: var(--color-text);
  }
  .tp-name a:hover {
    color: var(--cluster-ink, var(--color-primary));
  }
  .tp-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: var(--measure);
    margin: 0;
  }
  /* On a phone the directory is the point: three lines of what a topic covers
     (the whole description is on its own page, one tap away). */
  @media (max-width: 559.98px) {
    .tp-desc {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
  /* The homepage's "Browse all N lessons": the count is a way in, not a label. */
  .tp-browse {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--cluster-ink, var(--color-primary));
  }
  .tp-browse:hover {
    color: var(--cluster-ink, var(--color-primary));
  }
  .tp-browse :global(.icon) {
    width: 18px;
    height: 18px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .tp-browse:hover :global(.icon) {
    transform: translateX(2px);
  }

  .tp-visitors-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    max-width: var(--measure);
    color: var(--color-text-secondary);
  }

  .tp-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-5) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }
  .tp-end-search {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: var(--weight-ui);
  }
  .tp-end-search:hover {
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    color: var(--color-primary);
    text-decoration: none;
  }
</style>
