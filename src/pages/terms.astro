---
// Change `updated` with the words, not with the design. The repository has no
// licence file (checked 2026-09-29), so this page says only that the code is
// public and that the content licence does not cover it; name a code licence
// here when one is added.
import InfoLayout from '../layouts/InfoLayout.astro';
import InfoSection from '../components/InfoSection.astro';
---

<InfoLayout
  title="Terms"
  description="Content license and platform usage."
  heading="Terms of use"
  lede="Learn Civic Sense is a free reading library. The terms below cover content licensing, acceptable use, and the limits of what we can promise."
  updated="2026-09-29"
>
  <InfoSection heading="Content license">
    <p>
      All lessons on this site are published under the
      <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener noreferrer"
        >Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)</a
      >
      license. You may copy, adapt, and redistribute the lessons, including for commercial purposes, as
      long as you credit Learn Civic Sense (learncivicsense.in) and share derivatives under the same license.
    </p>
  </InfoSection>

  <InfoSection heading="Source code">
    <p>
      The code that runs this website is public in its
      <a href="https://github.com/gragtajar/lcs" rel="noopener noreferrer">GitHub repository</a>.
      The content license above covers the lessons, not the code.
    </p>
  </InfoSection>

  <InfoSection heading="Acceptable use">
    <ul>
      <li>You may read, share, and link to lessons freely.</li>
      <li>You may quote and adapt content under the CC BY-SA 4.0 terms.</li>
      <li>You may not misrepresent the site as your own, or strip attribution.</li>
      <li>You may not deploy automated abuse (scraping at scale that strains the site).</li>
    </ul>
  </InfoSection>

  <InfoSection heading="No warranty">
    <p>
      Lessons aim for accuracy and link the sources they cite, but the site is not professional
      legal, medical, or safety advice. Where a lesson references Indian law or a regulation, treat
      the citation as a pointer to the source, not a final authority.
    </p>
  </InfoSection>

  <InfoSection heading="Changes">
    <p>
      We may update these terms. The current version is always at this URL, with the “last updated”
      date at the top of the page.
    </p>
  </InfoSection>
</InfoLayout>
