# learncivicsense.in — Apache configuration for the static build on GoDaddy
# cPanel hosting (ADR 008). It travels with the build (public/ -> dist/) and is
# uploaded by the Deploy production workflow. It carries the policy the
# Cloudflare `_headers` file used to describe: one canonical HTTPS origin,
# security headers, cache lifetimes, compression, and the site's own 404 page
# for every URL it has no page for.
#
# Every directive that needs a module sits inside <IfModule>, so a host without
# that module loses that one behaviour instead of answering 500 for the whole
# site. Directory listings are already off on this host, so `Options` (which
# not every host lets .htaccess change) is deliberately not used.

# No ErrorDocument: this host replaces the body of every error Apache generates
# with its own 13-byte "404 Not Found", whatever ErrorDocument says (tested in
# every form, PR #28). The 404 page is sent by 404.php instead (see below and
# ADR 010), which the host leaves alone.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One origin, https://learncivicsense.in, with path and query kept.
  # Plain HTTP goes to HTTPS (X-Forwarded-Proto guards against a loop if a
  # TLS-terminating proxy is ever put in front)...
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://learncivicsense.in%{REQUEST_URI} [R=301,L]

  # ...and any other host name (www, the bare IP) goes to the apex.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} !^learncivicsense\.in$ [NC]
  RewriteRule ^ https://learncivicsense.in%{REQUEST_URI} [R=301,L]

  # Addresses from before the site had two levels (ADR 011, 2026-09-28): a
  # lesson was /{topic}/{subtopic}/{lesson}/ and each subtopic had a page,
  # /{topic}/{subtopic}/. Every one of them moves permanently to its lesson
  # at /{topic}/{lesson}/ or to its topic at /{topic}/, with or without the
  # trailing slash, query string kept. The list is frozen: it is exactly the
  # 211 lesson and 120 subtopic addresses in the live sitemap on that day
  # (lcs-content 3b90727). Lessons added later never had such an address.
  # scripts/verify-deploy.mjs requests every one of them after each deploy,
  # and a unit test checks each still points at a page that exists.
  # BEGIN legacy addresses
  RewriteRule ^traffic/(honking-discipline|lane-discipline|signal-rules|pedestrian-rights|school-zones|parking-discipline|two-wheeler-behavior|drunk-driving|emergency-vehicles|rural-and-highway)/?$ /traffic/ [R=301,L]
  RewriteRule ^traffic/honking-discipline/(the-case-against-honking|honking-at-red-lights-and-what-it-costs-everyone|silence-zones-and-the-law-you-didnt-know-existed|the-three-honk-rule-and-why-one-is-usually-enough)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^traffic/lane-discipline/(the-lane-is-not-a-suggestion|why-straddling-two-lanes-slows-everyone-including-you|indicators-are-free-please-use-them)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^traffic/signal-rules/(red-yellow-green-what-each-actually-means|yellow-is-not-go-faster|the-walk-signal-at-intersections)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^traffic/pedestrian-rights/(the-zebra-crossing-is-not-optional|yielding-to-pedestrians-at-right-turns|why-parking-on-a-footpath-is-its-own-kind-of-violence)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^traffic/school-zones/(what-school-zone-signs-require-of-you|school-pickup-chaos-and-how-not-to-be-it)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^traffic/parking-discipline/(no-parking-zones-exist-for-reasons-that-arent-conspiracy|double-parking-and-the-math-of-one-block-at-a-time|how-to-parallel-park-without-occupying-two-slots)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^traffic/two-wheeler-behavior/(the-footpath-is-not-a-shortcut|helmets-not-a-vibe-choice|three-on-a-bike-and-why-it-ends-badly)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^traffic/drunk-driving/(drunk-driving-in-india-the-law-the-cost-the-alternatives)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^traffic/emergency-vehicles/(the-ambulance-behind-you-the-6-seconds-that-matter)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^traffic/rural-and-highway/(highway-driving-the-things-city-instinct-gets-wrong)/?$ /traffic/$1/ [R=301,L]
  RewriteRule ^water-pools/(pool-hygiene|pool-etiquette|children-in-pools|sea-and-beach|lakes-and-rivers|waterparks)/?$ /water-pools/ [R=301,L]
  RewriteRule ^water-pools/pool-hygiene/(shower-before-entry|what-chlorine-does-and-doesnt-do)/?$ /water-pools/$1/ [R=301,L]
  RewriteRule ^water-pools/pool-etiquette/(lap-lanes-and-why-splashing-in-them-is-hostile|the-cannonball-question)/?$ /water-pools/$1/ [R=301,L]
  RewriteRule ^water-pools/children-in-pools/(watching-your-kids-what-lifeguard-on-duty-does-and-doesnt-mean)/?$ /water-pools/$1/ [R=301,L]
  RewriteRule ^water-pools/sea-and-beach/(the-flags-at-indian-beaches-and-what-they-actually-mean|beach-trash-the-receipt-of-your-visit)/?$ /water-pools/$1/ [R=301,L]
