  RewriteRule ^water-pools/waterparks/(the-unwritten-rules-of-water-parks)/?$ /water-pools/$1/ [R=301,L]
  RewriteRule ^public-spaces/(sidewalks-and-footpaths|parks-and-playgrounds|markets-and-bazaars|parking-lots-as-spaces|bus-stops-and-stations|waste-disposal|smoking-in-public|pet-behavior)/?$ /public-spaces/ [R=301,L]
  RewriteRule ^public-spaces/sidewalks-and-footpaths/(the-footpath-is-for-walking|encroachment-and-the-small-daily-choice|walking-three-abreast-in-single-file-paths)/?$ /public-spaces/$1/ [R=301,L]
  RewriteRule ^public-spaces/parks-and-playgrounds/(park-benches-dogs-and-shared-sittership|playgrounds-and-which-equipment-is-for-which-age|the-morning-walker-evening-walker-truce)/?$ /public-spaces/$1/ [R=301,L]
