# learncivicsense.in — Apache configuration for the static build on GoDaddy
# cPanel hosting (ADR 008). It travels with the build (public/ -> dist/) and is
# uploaded by the Deploy production workflow. It carries the policy the
# Cloudflare `_headers` file used to describe: one canonical HTTPS origin,
# security headers, cache lifetimes, compression, and the site's own 404 page
# for every URL it has no page for.
#
# Every directive that needs a module sits inside <IfModule>, so a host without
# that module loses that one behaviour instead of answering 500 for the whole
# site. Directory listings are already off on this host, so `Options` (which
# not every host lets .htaccess change) is deliberately not used.

# No ErrorDocument: this host replaces the body of every error Apache generates
# with its own 13-byte "404 Not Found", whatever ErrorDocument says (tested in
# every form, PR #28). The 404 page is sent by 404.php instead (see below and
# ADR 010), which the host leaves alone.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One origin, https://learncivicsense.in, with path and query kept.
  # Plain HTTP goes to HTTPS (X-Forwarded-Proto guards against a loop if a
  # TLS-terminating proxy is ever put in front)...
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://learncivicsense.in%{REQUEST_URI} [R=301,L]

  # ...and any other host name (www, the bare IP) goes to the apex.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} !^learncivicsense\.in$ [NC]
  RewriteRule ^ https://learncivicsense.in%{REQUEST_URI} [R=301,L]

  # Every URL the site has no page for gets the site's 404 page, with status
  # 404, from 404.php (an internal rewrite: the address bar keeps the URL).
  # Nothing whose name starts with a dot is served (the deploy's
  # .ftp-deploy-sync-state.json, the host's .ftpquota), except .well-known,
  # which certificate renewal reads...
  RewriteRule "(^|/)\.(?!well-known(/|$))" /404.php [L]
  # ...nor anything missing...
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404.php [L]
  # ...nor a folder without a page of its own (/_astro/, /fonts/), which the
  # host would otherwise answer with its bare 403.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ /404.php [L]
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  # Pagefind's index files are pre-compressed binary blobs read by fetch().
  AddType application/octet-stream .pagefind .pf_fragment .pf_index .pf_meta
  AddCharset utf-8 .html .css .js .mjs .json .webmanifest .svg .xml .txt
</IfModule>

<IfModule mod_filter.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json application/xml text/xml image/svg+xml text/plain
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Cache lifetimes. Build assets and fonts carry content hashes or never
  # change in place; the search index changes with content; the deploy marker
  # and a not-found answer must never be cached (a missing page may be
  # published a minute later); HTML is short-lived so a deploy shows within
  # minutes.
  <If "%{REQUEST_URI} =~ m#^/(_astro|fonts|images)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/pagefind/#">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </ElseIf>
  <ElseIf "%{REQUEST_URI} =~ m#^/placeholders/#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
  <ElseIf "%{REQUEST_URI} == '/build-info.json' || %{REQUEST_URI} == '/404.php'">
    Header set Cache-Control "no-store"
  </ElseIf>
  <ElseIf "%{REQUEST_URI} =~ m#^/sitemap[^/]*\.xml$#">
    Header set Cache-Control "public, max-age=3600"
  </ElseIf>
  <Else>
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </Else>
</IfModule>
